{
  "name": "uptime-monitor",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --port 4330",
    "build": "astro build",
    "preview": "astro preview",
    "db:migrate:local": "wrangler d1 migrations apply upbeat --local",
    "db:migrate:remote": "wrangler d1 migrations apply upbeat --remote",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^6.4.8",
    "better-auth": "^1.7.27",
    "kysely": "^0.29.9",
    "kysely-d1": "^0.4.0",
    "tailwindcss": "^4.3.5"
  },
  "overrides": {
    "vite": "7.3.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "wrangler": "^4.166.0"
  }
}
