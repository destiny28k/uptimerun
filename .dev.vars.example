# Copy to .dev.vars for local development. Never commit .dev.vars.
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# Optional locally. Without them, alerts are logged to the console instead of sent.
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
# Social logins (optional). Callback URL: <APP_URL>/api/auth/callback/<google|github>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Local dev URL (overrides the production value in wrangler.jsonc)
APP_URL=http://localhost:4330
