---
// Honest reasons to trust UptimeRun (no invented numbers or testimonials).
import { SITE } from '../site';
const points = [
  { title: 'Built on proven infrastructure', text: 'Checks run on Cloudflare’s global network, the same platform that serves a large share of the web.', icon: 'M17.5 19a4.5 4.5 0 1 0-1.4-8.8A6 6 0 1 0 6 16.5M6 19h11.5' },
  { title: 'Alerts you can believe', text: 'A failed check is confirmed by a second check before we alert, so an alert always means something is really wrong.', icon: 'M9 12l2 2 4-4M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z' },
  { title: 'Secure payments', text: 'Paid plans are handled by our payment partner. We never see or store your card details.', icon: 'M3 7h18v12H3zM3 11h18M7 15h3' },
  { title: 'Privacy first', text: 'We only collect what we need to run the service, and we never sell your data.', icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z' },
  { title: 'No lock-in', text: 'Monthly plans, cancel any time from your dashboard, and a clear refund policy.', icon: 'M8 11V7a4 4 0 0 1 7.5-2M5 11h14v10H5z' },
  { title: 'Real humans', text: `Questions? Email ${SITE.email} and a real person replies.`, icon: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z' },
];
---
<section id="trust" class="border-t border-white/5 py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">Why UptimeRun</p>
      <h2 class="mt-4 text-3xl sm:text-5xl font-semibold tracking-tight text-white text-balance"><span class="text-sheen">Monitoring you can</span> <span class="accent text-brand-soft">rely on.</span></h2>
      <p class="mt-4 text-slate-400">The tool that watches your website has to be the most dependable thing you run. Here’s how we earn that.</p>
    </div>
    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {points.map((p, i) => (
        <div class="reveal card p-6 text-center sm:text-left" style={`--d:${(i % 3) * 80}ms`}>
          <span class="mx-auto grid size-9 place-items-center rounded-lg bg-white/[0.04] sm:mx-0 text-brand-soft ring-1 ring-white/10">
            <svg viewBox="0 0 24 24" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={p.icon} /></svg>
          </span>
          <h3 class="mt-4 font-semibold text-white">{p.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-slate-400">{p.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
