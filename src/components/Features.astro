---
const features = [
  { title: '1-minute checks', text: 'We check your sites every 60 seconds from the edge, so you hear about problems before your customers do.', icon: 'M12 6v6l4 2M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z' },
  { title: 'Instant alerts, anywhere', text: 'Email, Telegram, Slack and Discord, free on every plan. Get told the moment it breaks, and when it’s fixed.', icon: 'M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.9 1.9 0 0 0 3.4 0' },
  { title: 'Beautiful status pages', text: 'A public page that shows customers what is up, on your own domain. Ready in one click.', icon: 'M3 3h18v18H3zM3 9h18M9 21V9' },
  { title: 'Keyword monitoring', text: 'A page can load and still be broken. Check that "Add to cart" or "Login" is really there.', icon: 'M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM21 21l-4.3-4.3' },
  { title: 'SSL and domain expiry', text: 'Get warned 30, 14 and 7 days before your certificate or domain expires. No more surprise outages.', icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z' },
  { title: 'Fair, simple pricing', text: '10 monitors free forever, commercial use included. Pro starts at $8/month.', icon: 'M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6' },
];
---
<section id="features" class="relative border-t border-white/5 py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">Everything you need</p>
      <h2 class="mt-4 text-3xl sm:text-5xl font-semibold tracking-tight text-white text-balance">
        <span class="text-sheen">Monitoring that just works,</span> <span class="accent text-brand-soft">without the enterprise price.</span>
      </h2>
      <p class="mt-4 text-slate-400">Set up your first monitor in 30 seconds. No servers, no config files, no learning curve.</p>
    </div>

    <div class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/5 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f, i) => (
        <div class="reveal group bg-ink-950 p-7 hover:bg-ink-900 transition-colors" style={`--d:${(i % 3) * 100 + Math.floor(i / 3) * 80}ms`}>
          <span class="grid place-items-center size-10 rounded-lg bg-brand/10 ring-1 ring-brand/20 text-brand">
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={f.icon} /></svg>
          </span>
          <h3 class="mt-5 text-base font-semibold text-white">{f.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-400">{f.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
