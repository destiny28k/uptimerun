---
import { SITE } from '../site';
import { responseTimes } from '../data/mock';

// Mock data for the hero dashboard preview (UI only).
const monitors = [
  { name: 'myshop.com', type: 'HTTPS', up: true, ms: '182 ms', uptime: '99.99%', down: [] as number[] },
  { name: 'api.myshop.com', type: 'HTTPS', up: true, ms: '96 ms', uptime: '99.95%', down: [21] },
  { name: 'blog.studio.io', type: 'Keyword', up: false, ms: 'Down · 3 min', uptime: '98.71%', down: [6, 7, 29] },
  { name: 'client-site.fr', type: 'SSL', up: true, ms: '241 ms', uptime: '100%', down: [] },
];
const bars = Array.from({ length: 30 }, (_, i) => i);
const stats = [
  { label: 'Monitors up', value: '11', tone: 'text-brand' },
  { label: 'Down', value: '1', tone: 'text-red-400' },
  { label: 'Avg response', value: '182 ms', tone: 'text-white' },
  { label: 'Uptime · 30d', value: '99.98%', tone: 'text-white' },
];
const sideNav = ['Monitors', 'Incidents', 'Status pages', 'Alerts', 'Settings'];

// Response-time sparkline (SVG 400x90).
const W = 400, H = 90, max = 350;
const pts = responseTimes.map((v, i) => [(i / (responseTimes.length - 1)) * W, H - (v / max) * H]);
const line = pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
const area = `${line} L${W},${H} L0,${H} Z`;
---
<section class="relative overflow-hidden">
  <div class="grid-bg absolute inset-0 pointer-events-none"></div>
  <div class="glow absolute inset-0 pointer-events-none"></div>

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6 pt-16 sm:pt-24 pb-20">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="text-4xl sm:text-6xl font-semibold tracking-tight text-white text-balance">
        <span class="mb-4 block text-sm sm:text-base font-semibold uppercase tracking-[0.2em] text-brand">Free website uptime monitoring</span>
        Know the second your website <span class="text-brand">goes down</span>
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-base sm:text-lg text-slate-400 text-pretty">
        Monitor your website, API and SSL certificate every minute. Get instant downtime alerts on Email, Telegram, Slack and Discord,
        and share a <span class="text-white font-medium">public status page</span> with your users.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/signup" class="w-full sm:w-auto rounded-lg bg-brand px-6 py-3 text-sm font-semibold text-ink-950 shadow-lg shadow-brand/20 hover:bg-brand-soft transition-colors">
          Start monitoring free
        </a>
        <a href="/status/demo" class="w-full sm:w-auto rounded-lg border border-white/10 bg-white/5 px-6 py-3 text-sm font-semibold text-white hover:bg-white/10 transition-colors">
          View live demo
        </a>
      </div>
      <ul class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-xs text-slate-500">
        <li>✓ No credit card</li>
        <li>✓ 10 monitors free forever</li>
        <li>✓ Commercial use allowed</li>
      </ul>
    </div>

    <!-- Dashboard preview -->
    <div class="relative mx-auto mt-16 max-w-5xl [perspective:1600px]">
      <div class="absolute -inset-x-10 -top-10 bottom-0 bg-brand/10 blur-3xl rounded-full pointer-events-none"></div>
      <div data-tilt class="tilt relative overflow-hidden rounded-2xl border border-white/10 bg-ink-900 shadow-2xl shadow-black/60 ring-1 ring-white/5">
        <!-- Browser bar -->
        <div class="flex items-center gap-4 border-b border-white/5 bg-ink-950/60 px-4 py-3">
          <div class="flex gap-1.5">
            <span class="size-2.5 rounded-full bg-[#ff5f57]/80"></span>
            <span class="size-2.5 rounded-full bg-[#febc2e]/80"></span>
            <span class="size-2.5 rounded-full bg-[#28c840]/80"></span>
          </div>
          <div class="mx-auto flex w-full max-w-sm items-center justify-center gap-2 rounded-md bg-white/5 px-3 py-1 text-[11px] text-slate-500">
            <svg viewBox="0 0 24 24" class="size-3" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
            app.{SITE.name.toLowerCase()}.com/dashboard
          </div>
          <span class="hidden sm:block w-12"></span>
        </div>

        <div class="grid md:grid-cols-[11rem_1fr]">
          <!-- Sidebar -->
          <aside class="hidden md:flex flex-col gap-1 border-r border-white/5 bg-ink-950/40 p-3 text-left">
            <span class="mb-2 rounded-md bg-brand px-2.5 py-1.5 text-center text-[11px] font-semibold text-ink-950">+ New monitor</span>
            {sideNav.map((n, i) => (
              <span class:list={['rounded-md px-2.5 py-1.5 text-xs', i === 0 ? 'bg-white/[0.06] text-white' : 'text-slate-500']}>{n}</span>
            ))}
            <div class="mt-auto rounded-lg border border-white/10 p-2.5">
              <p class="text-[10px] text-slate-500">Pro plan · 12 / 50</p>
              <div class="mt-1.5 h-1 rounded-full bg-white/5"><div class="h-full w-1/4 rounded-full bg-brand"></div></div>
            </div>
          </aside>

          <!-- Main -->
          <div class="min-w-0 p-4 sm:p-5 text-left">
            <div class="flex items-center justify-between">
              <p class="text-sm font-semibold text-white">Monitors</p>
              <span class="flex items-center gap-2 text-[11px] text-brand">
                <span class="relative size-2 rounded-full bg-brand text-brand pulse-dot"></span> Live
              </span>
            </div>

            <div class="mt-3 grid grid-cols-2 gap-2.5 lg:grid-cols-4">
              {stats.map((s) => (
                <div class="rounded-lg border border-white/5 bg-white/[0.02] px-3 py-2.5">
                  <p class="text-[10px] text-slate-500">{s.label}</p>
                  <p class:list={['mt-0.5 text-lg font-semibold tabular-nums', s.tone]}>{s.value}</p>
                </div>
              ))}
            </div>

            <div class="mt-3 hidden sm:block rounded-lg border border-white/5 bg-white/[0.02] p-3">
              <div class="flex items-center justify-between text-[11px]">
                <span class="font-medium text-slate-300">Response time · myshop.com</span>
                <span class="text-slate-500">Last 24h</span>
              </div>
              <svg viewBox={`0 0 ${W} ${H}`} class="mt-2 h-20 w-full" preserveAspectRatio="none" aria-hidden="true">
                <defs>
                  <linearGradient id="hero-rt" x1="0" x2="0" y1="0" y2="1">
                    <stop offset="0%" stop-color="#22c55e" stop-opacity="0.35" />
                    <stop offset="100%" stop-color="#22c55e" stop-opacity="0" />
                  </linearGradient>
                </defs>
                <path d={area} fill="url(#hero-rt)" />
                <path d={line} fill="none" stroke="#22c55e" stroke-width="1.5" vector-effect="non-scaling-stroke" />
              </svg>
            </div>

            <ul class="mt-3 divide-y divide-white/5 rounded-lg border border-white/5">
              {monitors.map((m) => (
                <li class="grid grid-cols-[1fr_auto] sm:grid-cols-[minmax(0,10rem)_1fr_auto] items-center gap-3 px-3 py-2.5">
                  <div class="flex min-w-0 items-center gap-2.5">
                    <span class:list={['relative size-2 shrink-0 rounded-full', m.up ? 'bg-brand text-brand' : 'bg-red-500 text-red-500 pulse-dot']}></span>
                    <div class="min-w-0">
                      <p class="truncate text-xs font-medium text-white">{m.name}</p>
                      <p class:list={['text-[10px]', m.up ? 'text-slate-500' : 'text-red-400']}>{m.type} · {m.ms}</p>
                    </div>
                  </div>
                  <div class="hidden sm:flex h-5 items-stretch gap-[2px]">
                    {bars.map((b) => (
                      <span class:list={['flex-1 rounded-[1px]', m.down.includes(b) ? 'bg-red-500/85' : 'bg-brand/60']}></span>
                    ))}
                  </div>
                  <span class:list={['text-xs font-medium tabular-nums', m.up ? 'text-slate-300' : 'text-red-400']}>{m.uptime}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <!-- Alert toast -->
      <div class="toast absolute -bottom-6 right-2 sm:-right-6 w-72 rounded-xl border border-white/10 bg-ink-800 p-4 shadow-2xl shadow-black/60">
        <div class="flex items-start gap-3">
          <span class="grid place-items-center size-8 shrink-0 rounded-lg bg-sky-500/15 text-sky-400">
            <svg viewBox="0 0 24 24" class="size-4" fill="currentColor"><path d="M21.9 4.6 18.7 19.7c-.2 1-.9 1.3-1.7.8l-4.8-3.5-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.9 8.9-8c.4-.3-.1-.5-.6-.2L6.5 13.6l-4.7-1.5c-1-.3-1-1 .2-1.5L20.6 3.4c.9-.3 1.6.2 1.3 1.2Z"/></svg>
          </span>
          <div class="min-w-0">
            <p class="text-sm font-semibold text-white">blog.studio.io is down</p>
            <p class="text-xs text-slate-400 mt-0.5">Keyword "Add to cart" not found · Telegram · just now</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
