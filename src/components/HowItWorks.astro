---
const steps = [
  { n: '01', title: 'Add your website', text: 'Paste your URL and give it a name. That’s it. No code, no plugins, no servers.' },
  { n: '02', title: 'We check every minute', text: 'We visit your site around the clock and re-check any failure before alerting, so you don’t get false alarms.' },
  { n: '03', title: 'Get alerted instantly', text: 'The moment it goes down, you hear about it on your favourite channel. And again when it’s back up.' },
];
---
<section id="how" class="border-t border-white/5 py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold text-brand">How it works</p>
      <h2 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight text-white text-balance">Up and running in 30 seconds</h2>
      <p class="mt-4 text-slate-400">Three steps between you and peace of mind.</p>
    </div>

    <div class="relative mt-14 grid gap-6 md:grid-cols-3">
      <div class="absolute left-0 right-0 top-6 hidden md:block h-px bg-gradient-to-r from-transparent via-brand/30 to-transparent"></div>
      {steps.map((s, i) => (
        <div class="reveal lift relative rounded-2xl border border-white/10 bg-ink-900/60 p-7" style={`--d:${i * 120}ms`}>
          <span class="grid size-12 place-items-center rounded-xl bg-ink-950 ring-1 ring-brand/30 text-sm font-semibold text-brand">{s.n}</span>
          <h3 class="mt-5 text-lg font-semibold text-white">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-400">{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
