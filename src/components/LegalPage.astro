---
// Shared layout for About, Contact and policy pages.
import Base from '../layouts/Base.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';

interface Props { title: string; heading: string; description: string; path: string; updated?: string }
const { title, heading, description, path, updated } = Astro.props;
---
<Base title={title} description={description} breadcrumb={[{ name: heading, path }]}>
  <Navbar />
  <main class="mx-auto max-w-3xl px-4 sm:px-6 py-16 sm:py-24">
    <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-white">{heading}</h1>
    {updated && <p class="mt-2 text-sm text-slate-500">Last updated: {updated}</p>}
    <div class="mt-10 space-y-5 text-[15px] leading-relaxed text-slate-400 [&_h2]:mt-10 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-white [&_strong]:text-slate-200 [&_a]:text-brand [&_a:hover]:text-brand-soft [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5">
      <slot />
    </div>
  </main>
  <Footer />
</Base>
