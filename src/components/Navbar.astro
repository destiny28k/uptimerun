---
import Logo from './Logo.astro';
const links = [
  { href: '/#features', label: 'Features' },
  { href: '/#how', label: 'How it works' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/status/demo', label: 'Status pages' },
];
// Signed-in visitors (session cookie present) see "Dashboard" instead of Log in / Start free.
const signedIn = Astro.cookies.has('__Secure-better-auth.session_token') || Astro.cookies.has('better-auth.session_token');
---
<header class="sticky top-0 z-50 border-b border-white/5 bg-ink-950/70 backdrop-blur-xl">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <Logo />
    <ul class="hidden md:flex items-center gap-8 text-sm text-slate-400">
      {links.map((l) => <li><a href={l.href} class="hover:text-white transition-colors">{l.label}</a></li>)}
    </ul>
    <div class="flex items-center gap-2">
      {signedIn ? (
      <a href="/dashboard" class="inline-flex items-center rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-ink-950 hover:bg-brand-soft transition-colors">
        Go to dashboard →
      </a>
      ) : (<>
      <a href="/login" class="hidden sm:inline-flex px-3 py-2 text-sm text-slate-300 hover:text-white">Log in</a>
      <a href="/signup" class="inline-flex items-center rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-ink-950 hover:bg-brand-soft transition-colors">
        Start free
      </a>
      </>)}
    </div>
  </nav>
</header>
