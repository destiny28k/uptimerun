---
import Logo from './Logo.astro';
import { SITE } from '../site';
const groups = [
  { title: 'Product', links: [['Features', '/#features'], ['Pricing', '/pricing'], ['Status page example', '/status/demo'], ['Uptime monitoring guide', '/#guide']] },
  { title: 'Get started', links: [['Sign up free', '/signup'], ['Log in', '/login'], ['FAQ', '/#faq']] },
  { title: 'Company', links: [['About', '/about'], ['Contact', '/contact']] },
  { title: 'Legal', links: [['Privacy Policy', '/privacy'], ['Terms of Service', '/terms'], ['Refund Policy', '/refund-policy']] },
];
---
<section class="border-t border-white/5">
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6 py-24 text-center">
    <div class="glow absolute inset-0 pointer-events-none"></div>
    <h2 class="relative text-3xl sm:text-5xl font-semibold tracking-tight text-white text-balance">Stop finding out from your customers.</h2>
    <p class="relative mt-4 text-slate-400">Your first monitor takes 30 seconds. Free forever for 10 sites.</p>
    <a href="/signup" class="relative mt-8 inline-flex rounded-lg bg-brand px-6 py-3 text-sm font-semibold text-ink-950 shadow-lg shadow-brand/20 hover:bg-brand-soft transition-colors">Start monitoring free</a>
  </div>
</section>
<footer class="border-t border-white/5">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 py-14 md:grid-cols-[1.5fr_repeat(4,1fr)]">
    <div>
      <Logo />
      <p class="mt-4 max-w-xs text-sm text-slate-500">Simple, fair uptime monitoring and status pages for everyone.</p>
      <p class="mt-4 inline-flex items-center gap-2 rounded-full border border-white/10 px-3 py-1 text-xs text-slate-400">
        <span class="size-2 rounded-full bg-brand"></span> All systems operational
      </p>
    </div>
    {groups.map((g) => (
      <div>
        <p class="text-sm font-semibold text-white">{g.title}</p>
        <ul class="mt-4 space-y-2.5 text-sm text-slate-500">
          {g.links.map(([label, href]) => <li><a href={href} class="hover:text-slate-300">{label}</a></li>)}
        </ul>
      </div>
    ))}
  </div>
  <div class="border-t border-white/5 py-6 text-center text-xs text-slate-600">
    © {new Date().getFullYear()} {SITE.name}. All rights reserved. · <a href={`mailto:${SITE.email}`} class="hover:text-slate-400">{SITE.email}</a>
  </div>
</footer>
