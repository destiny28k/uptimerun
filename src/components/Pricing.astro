---
// Plan cards with a Monthly / Yearly switch. Used on the landing page and /pricing.
import { PLANS, YEARLY_SAVING } from '../data/plans';
interface Props { heading?: boolean; compareLink?: boolean }
const { heading = true, compareLink = true } = Astro.props;
const fmt = (n: number) => (Number.isInteger(n) ? `$${n}` : `$${n.toFixed(2)}`);
---
<section id="pricing" data-billing="yearly" class="group/billing border-t border-white/5 py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    {heading && (
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow">Pricing</p>
        <h2 class="mt-4 text-3xl sm:text-5xl font-semibold tracking-tight text-white text-balance"><span class="text-sheen">Simple pricing.</span> <span class="accent text-brand-soft">No surprises.</span></h2>
        <p class="mt-4 text-slate-400">Start free. Upgrade when you need faster checks and more monitors. Cancel any time.</p>
      </div>
    )}

    <!-- Monthly / Yearly switch -->
    <div class="mt-10 flex justify-center">
      <div role="radiogroup" aria-label="Billing period" class="inline-flex items-center gap-1 rounded-full border border-white/10 bg-white/[0.03] p-1 text-sm">
        <button type="button" role="radio" data-set-billing="monthly"
          class="rounded-full px-4 py-1.5 font-medium text-slate-400 transition-colors group-data-[billing=monthly]/billing:bg-white/10 group-data-[billing=monthly]/billing:text-white">Monthly</button>
        <button type="button" role="radio" data-set-billing="yearly"
          class="flex items-center gap-2 rounded-full px-4 py-1.5 font-medium text-slate-400 transition-colors group-data-[billing=yearly]/billing:bg-white/10 group-data-[billing=yearly]/billing:text-white">
          Yearly <span class="rounded-full bg-brand/15 px-2 py-0.5 text-xs font-semibold text-brand">Save {YEARLY_SAVING}%</span>
        </button>
      </div>
    </div>

    <div class="mt-12 grid items-center gap-6 lg:grid-cols-3">
      {PLANS.map((p, i) => (
        <div style={`--d:${i * 120}ms`} class:list={[
          'reveal lift relative flex flex-col rounded-2xl border p-8',
          p.featured ? 'plan-featured border-brand/40 lg:-my-3 lg:py-11' : 'card border-transparent',
        ]}>
          {p.featured && <span class="btn-primary absolute -top-3 left-8 rounded-full px-3 py-1 text-xs font-semibold text-ink-950">Most popular</span>}
          <h3 class:list={['text-lg font-semibold', p.featured ? 'text-brand-soft' : 'text-white']}>{p.name}</h3>
          <p class="mt-1 text-sm text-slate-400">{p.blurb}</p>

          <div class="mt-6 min-h-[4.5rem]">
            {p.monthly === 0 ? (
              <>
                <p class="flex items-baseline gap-2"><span class="text-5xl font-semibold tracking-tight text-white">$0</span><span class="text-sm text-slate-500">forever</span></p>
                <p class="mt-1 text-xs text-slate-500">No credit card needed</p>
              </>
            ) : (
              <>
                <p class="flex items-baseline gap-2 group-data-[billing=yearly]/billing:hidden">
                  <span class="text-5xl font-semibold tracking-tight text-white">{fmt(p.monthly)}</span><span class="text-sm text-slate-500">/ month</span>
                </p>
                <p class="mt-1 text-xs text-slate-500 group-data-[billing=yearly]/billing:hidden">Billed monthly</p>
                <p class="hidden items-baseline gap-2 group-data-[billing=yearly]/billing:flex">
                  <span class="text-5xl font-semibold tracking-tight text-white">{fmt(p.yearly / 12)}</span><span class="text-sm text-slate-500">/ month</span>
                  <span class="text-sm text-slate-600 line-through">{fmt(p.monthly)}</span>
                </p>
                <p class="mt-1 hidden text-xs text-slate-500 group-data-[billing=yearly]/billing:block">{fmt(p.yearly)} billed yearly</p>
              </>
            )}
          </div>

          <a href="/signup" class:list={[
            'mt-7 rounded-xl px-4 py-3 text-center text-sm font-semibold',
            p.featured ? 'btn-primary text-ink-950' : 'btn-ghost text-white',
          ]}>{p.cta}</a>
          <div class="mt-7 h-px bg-white/[0.07]"></div>
          <ul class="mt-7 space-y-3.5 text-sm text-slate-300">
            {p.highlights.map((h) => (
              <li class="flex gap-3">
                <span class="mt-px grid size-[18px] shrink-0 place-items-center rounded-full bg-brand/15 text-brand-soft"><svg viewBox="0 0 24 24" class="size-3" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                {h}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    {compareLink && (
      <p class="mt-10 text-center text-sm text-slate-400">
        <a href="/pricing#compare" class="font-medium text-brand hover:text-brand-soft">Compare all features →</a>
      </p>
    )}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-set-billing]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const section = btn.closest<HTMLElement>('[data-billing]')!;
      section.dataset.billing = btn.dataset.setBilling!;
      section.querySelectorAll('[data-set-billing]').forEach((b) =>
        b.setAttribute('aria-checked', String(b === btn)));
    });
  });
</script>
