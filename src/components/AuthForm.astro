---
import Logo from './Logo.astro';
import { env } from 'cloudflare:workers';
import { configuredProviders } from '../lib/auth';
interface Props { mode: 'login' | 'signup' }
const { mode } = Astro.props;
const isSignup = mode === 'signup';
const enabled = configuredProviders(env);
// Better Auth sends people back with ?error=... if a link or social login fails.
const error = Astro.url.searchParams.get('error') ? 'That sign-in link didn’t work or has expired. Please try again.' : '';

const socials = [
  { id: 'google', label: 'Google', icon: '<path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.2-2.1 3.5-5.1 3.5-8.8Z"/><path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.7-5H1.3v3.1A12 12 0 0 0 12 24Z"/><path fill="#FBBC05" d="M5.3 14.3a7.2 7.2 0 0 1 0-4.6V6.6h-4a12 12 0 0 0 0 10.8l4-3.1Z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.3 6.6l4 3.1c.9-2.9 3.6-4.9 6.7-4.9Z"/>' },
  { id: 'github', label: 'GitHub', icon: '<path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/>' },
];
const field = 'w-full rounded-lg border border-white/10 bg-white/[0.03] py-3 pl-10 pr-3 text-sm text-white placeholder:text-slate-500 outline-none focus:border-brand/50 focus:bg-white/[0.05] transition-colors';
const iconCls = 'pointer-events-none absolute left-3 top-1/2 size-[18px] -translate-y-1/2 text-slate-500';
---
<div class="relative min-h-screen overflow-hidden">
  <div class="grid-bg absolute inset-0 pointer-events-none"></div>
  <div class="glow absolute inset-0 pointer-events-none"></div>
  <div class="relative mx-auto flex min-h-screen max-w-md flex-col justify-center px-4 py-12">
    <div class="flex justify-center"><Logo /></div>

    <div class="mt-8 rounded-2xl border border-white/10 bg-ink-900/80 p-7 shadow-2xl shadow-black/50 backdrop-blur">
      <!-- Step 1: the form -->
      <div id="step-form">
        <h1 class="text-2xl font-semibold tracking-tight text-white">{isSignup ? <>Start monitoring now<span class="text-brand">.</span></> : 'Welcome back'}</h1>
        <p class="mt-1 text-sm text-slate-400">{isSignup ? 'Free forever for 10 monitors. No credit card, no password.' : 'We’ll email you a magic link to sign in. No password needed.'}</p>

        <form id="auth-form" data-mode={mode} class="mt-7 space-y-5" novalidate>
          {isSignup && (
            <div>
              <label for="site" class="mb-2 block text-sm font-semibold text-white">Website to monitor</label>
              <div class="relative">
                <svg class={iconCls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>
                <input id="site" name="site" inputmode="url" autocomplete="url" class={field} placeholder="eg. mywebsite.com" />
              </div>
            </div>
          )}
          <div>
            <label for="email" class="mb-2 block text-sm font-semibold text-white">{isSignup ? 'Create your account' : 'Email'}</label>
            <div class="relative">
              <svg class={iconCls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
              <input id="email" name="email" type="email" required autocomplete="email" class={field} placeholder="eg. your@email.com" />
            </div>
          </div>
          <p id="auth-error" class:list={['rounded-lg border border-red-500/30 bg-red-500/10 px-3 py-2 text-sm text-red-300', !error && 'hidden']}>{error}</p>
          <button class="flex w-full items-center justify-center gap-2 rounded-lg bg-brand py-3 text-sm font-semibold text-ink-950 hover:bg-brand-soft disabled:opacity-60 transition-colors">
            <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
            {isSignup ? 'Register with email' : 'Send me a login link'}
          </button>
        </form>

        <div class="my-6 flex items-center gap-3 text-xs text-slate-500">
          <span class="h-px flex-1 bg-white/10"></span>or<span class="h-px flex-1 bg-white/10"></span>
        </div>

        <div class="grid gap-2.5">
          {socials.map((s) => (
            <button type="button" data-provider={s.id} data-label={s.label} data-enabled={enabled.includes(s.id as any) ? '1' : ''}
              class="social flex w-full items-center justify-center gap-3 rounded-lg border border-white/10 bg-white/[0.04] py-2.5 text-sm font-medium text-white hover:bg-white/[0.08] transition-colors disabled:opacity-60">
              <svg viewBox="0 0 24 24" class="size-[18px]" aria-hidden="true" set:html={s.icon} />
              Continue with {s.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Step 2: check your inbox -->
      <div id="step-sent" class="hidden text-center">
        <span class="mx-auto grid size-14 place-items-center rounded-2xl bg-brand/10 ring-1 ring-brand/30 text-brand">
          <svg viewBox="0 0 24 24" class="size-7" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
        </span>
        <h2 class="mt-5 text-xl font-semibold text-white">Check your inbox</h2>
        <p class="mt-2 text-sm text-slate-400">We sent a sign-in link to <span id="sent-to" class="font-medium text-white"></span>. It expires in 15 minutes.</p>
        <p id="sent-site" class="mt-3 hidden text-sm text-slate-400">We’ll start monitoring <span class="font-medium text-brand"></span> as soon as you click it.</p>
        <button id="again" type="button" class="mt-6 text-sm font-medium text-brand hover:text-brand-soft">Use a different email</button>
      </div>
    </div>

    <p class="mt-6 text-center text-sm text-slate-400">
      {isSignup ? 'Already have an account? ' : 'New here? '}
      <a href={isSignup ? '/login' : '/signup'} class="font-medium text-brand hover:text-brand-soft">{isSignup ? 'Log in' : 'Create a free account'}</a>
    </p>
  </div>
</div>

<script>
  const form = document.getElementById('auth-form') as HTMLFormElement;
  const err = document.getElementById('auth-error')!;
  const showError = (msg: string) => { err.textContent = msg; err.classList.remove('hidden'); };
  const siteInput = document.getElementById('site') as HTMLInputElement | null;

  /** Where to land after sign-in. New users with a website go to /dashboard/welcome to create it. */
  function callbacks() {
    const site = siteInput?.value.trim() ?? '';
    const welcome = site ? `/dashboard/welcome?url=${encodeURIComponent(site)}` : '/dashboard';
    return { callbackURL: welcome, newUserCallbackURL: welcome, errorCallbackURL: location.pathname };
  }

  function validSite() {
    const site = siteInput?.value.trim();
    if (!siteInput) return true;
    if (!site) { showError('Enter the website you want to monitor.'); siteInput.focus(); return false; }
    if (!/^(https?:\/\/)?[^\s/.]+\.[^\s]+$/i.test(site)) { showError('That doesn’t look like a website address, e.g. mywebsite.com'); siteInput.focus(); return false; }
    return true;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    err.classList.add('hidden');
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    if (!validSite()) return;
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return showError('Please enter a valid email address.');

    const btn = form.querySelector('button')!;
    btn.disabled = true;
    try {
      const res = await fetch('/api/auth/sign-in/magic-link', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email, ...callbacks() }),
      });
      if (res.ok) {
        document.getElementById('sent-to')!.textContent = email;
        const site = siteInput?.value.trim();
        if (site) {
          const p = document.getElementById('sent-site')!;
          p.querySelector('span')!.textContent = site;
          p.classList.remove('hidden');
        }
        document.getElementById('step-form')!.classList.add('hidden');
        document.getElementById('step-sent')!.classList.remove('hidden');
      } else {
        const body = await res.json().catch(() => ({}));
        showError(body.message || 'Something went wrong. Please try again.');
      }
    } catch {
      showError('Network error. Please try again.');
    }
    btn.disabled = false;
  });

  document.getElementById('again')!.addEventListener('click', () => {
    document.getElementById('step-sent')!.classList.add('hidden');
    document.getElementById('step-form')!.classList.remove('hidden');
  });

  // Social logins: ask Better Auth for the provider URL, then go there.
  document.querySelectorAll<HTMLButtonElement>('.social').forEach((btn) => {
    btn.addEventListener('click', async () => {
      err.classList.add('hidden');
      const name = btn.dataset.label;
      if (!btn.dataset.enabled) return showError(`${name} login isn’t set up yet. Use email for now.`);
      if (siteInput?.value.trim() && !validSite()) return;
      btn.disabled = true;
      try {
        const res = await fetch('/api/auth/sign-in/social', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ provider: btn.dataset.provider, ...callbacks() }),
        });
        const body = await res.json().catch(() => ({}));
        if (body.url) { location.href = body.url; return; }
        showError(body.message || `Couldn’t start ${name} login. Please try again.`);
      } catch { showError('Network error. Please try again.'); }
      btn.disabled = false;
    });
  });
</script>
