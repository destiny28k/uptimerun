---
// In-dashboard upgrade pop-up. Any link to /pricing inside the dashboard opens it (falls back to /pricing without JS).
import { PLANS, YEARLY_SAVING } from '../../data/plans';
import { SITE } from '../../site';
const current = Astro.locals.plan?.id ?? 'free';
const paid = PLANS.filter((p) => p.id !== 'free');
const rank = { free: 0, pro: 1, business: 2 } as const;
---
<dialog id="upgrade-modal" class="m-auto w-[min(56rem,calc(100%-2rem))] max-h-[calc(100dvh-2rem)] overflow-y-auto rounded-2xl border border-white/10 bg-ink-900 p-0 text-slate-300 shadow-2xl backdrop:bg-black/70 backdrop:backdrop-blur-sm">
  <div class="relative p-6 sm:p-8">
    <button type="button" data-close aria-label="Close" class="absolute right-4 top-4 grid size-9 place-items-center rounded-lg text-slate-400 hover:bg-white/5 hover:text-white">
      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <div class="flex flex-wrap items-end justify-between gap-4 pr-10">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight text-white">Unlock more with a paid plan<span class="text-brand">.</span></h2>
        <p class="mt-1 text-sm text-slate-400">Faster checks, more monitors and expiry alerts. Cancel any time.</p>
      </div>
      <div class="flex items-center gap-1 rounded-lg border border-white/10 bg-white/[0.03] p-1 text-sm" role="group" aria-label="Billing period">
        <button type="button" data-billing="monthly" class="billing-btn rounded-md px-3 py-1.5">Monthly</button>
        <button type="button" data-billing="yearly" class="billing-btn rounded-md px-3 py-1.5">Yearly <span class="ml-1 rounded bg-brand/15 px-1.5 py-0.5 text-xs font-semibold text-brand">-{YEARLY_SAVING}%</span></button>
      </div>
    </div>

    <div class="mt-7 grid gap-4 md:grid-cols-2">
      {paid.map((p) => {
        const isCurrent = p.id === current;
        const isLower = rank[p.id] < rank[current];
        return (
          <div class:list={['relative flex flex-col rounded-xl border p-6', p.featured ? 'border-brand/40 bg-brand/[0.04]' : 'border-white/10 bg-white/[0.02]']}>
            <div class="flex items-center justify-between">
              <h3 class="text-lg font-semibold text-white">{p.name}</h3>
              {isCurrent ? <span class="rounded-full border border-white/15 px-2.5 py-0.5 text-xs text-slate-300">Current plan</span>
                : p.featured && <span class="rounded-full bg-brand/15 px-2.5 py-0.5 text-xs font-semibold text-brand">Most popular</span>}
            </div>
            <p class="mt-1 text-sm text-slate-400">{p.blurb}</p>
            <p class="mt-5 flex items-baseline gap-1">
              <span class="text-4xl font-semibold tracking-tight text-white" data-price-monthly={`$${p.monthly}`} data-price-yearly={`$${p.yearly / 12}`}>${p.monthly}</span>
              <span class="text-sm text-slate-400">/month</span>
            </p>
            <p class="mt-1 h-5 text-xs text-slate-500" data-note-yearly={`$${p.yearly} billed yearly`} data-note-monthly="Billed monthly">Billed monthly</p>
            {isCurrent || isLower ? (
              <button type="button" disabled class="mt-5 w-full cursor-not-allowed rounded-lg border border-white/10 py-2.5 text-sm font-semibold text-slate-500">{isCurrent ? 'Your current plan' : 'Included in your plan'}</button>
            ) : (
              <a data-subscribe={p.id} href={`mailto:${SITE.email}?subject=${encodeURIComponent(`Upgrade to ${p.name}`)}`}
                class:list={['mt-5 block w-full rounded-lg py-2.5 text-center text-sm font-semibold transition-colors', p.featured ? 'bg-brand text-ink-950 hover:bg-brand-soft' : 'bg-white text-ink-950 hover:bg-slate-200']}>
                Upgrade to {p.name}
              </a>
            )}
            <ul class="mt-6 space-y-2.5 text-sm">
              {p.highlights.map((h) => (
                <li class="flex gap-2.5"><svg viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 text-brand" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg>{h}</li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
    <p class="mt-6 text-center text-xs text-slate-500">
      14-day money-back guarantee · Secure checkout · <a href="/pricing" data-no-modal target="_blank" class="text-slate-400 underline hover:text-white">Compare all features</a>
    </p>
  </div>
</dialog>

<script>
  const modal = document.getElementById('upgrade-modal') as HTMLDialogElement | null;
  if (modal) {
    const setBilling = (b: 'monthly' | 'yearly') => {
      modal.querySelectorAll<HTMLElement>('.billing-btn').forEach((btn) => {
        const on = btn.dataset.billing === b;
        btn.classList.toggle('bg-white/10', on);
        btn.classList.toggle('text-white', on);
        btn.classList.toggle('text-slate-400', !on);
      });
      modal.querySelectorAll<HTMLElement>('[data-price-monthly]').forEach((el) => (el.textContent = el.dataset[b === 'yearly' ? 'priceYearly' : 'priceMonthly']!));
      modal.querySelectorAll<HTMLElement>('[data-note-monthly]').forEach((el) => (el.textContent = el.dataset[b === 'yearly' ? 'noteYearly' : 'noteMonthly']!));
      modal.dataset.billing = b; // read by checkout later
    };
    setBilling('yearly');
    modal.querySelectorAll<HTMLElement>('.billing-btn').forEach((btn) => btn.addEventListener('click', () => setBilling(btn.dataset.billing as 'monthly' | 'yearly')));
    modal.querySelector('[data-close]')?.addEventListener('click', () => modal.close());
    modal.addEventListener('click', (e) => { if (e.target === modal) modal.close(); }); // click outside
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href="/pricing"]:not([data-no-modal]), [data-open-upgrade]');
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      modal.showModal();
    });
  }
</script>
