---
import Base from './Base.astro';
import Logo from '../components/Logo.astro';
import { env } from 'cloudflare:workers';
import { countMonitors } from '../lib/data';

interface Props { title: string; active: string; subtitle?: string }
const { title, active, subtitle } = Astro.props;
const user = Astro.locals.user!;
const used = await countMonitors(env.DB, user.id);
const plan = Astro.locals.plan!;
const usedPct = Math.min(100, Math.round((used / plan.limits.monitors) * 100));
// Magic-link users may have no name yet, so fall back to the email.
const displayName = user.name?.trim() || user.email.split('@')[0];
const initials = displayName.split(/[\s._-]+/).filter(Boolean).map((w) => w[0]).join('').slice(0, 2).toUpperCase();

const nav = [
  { id: 'monitors', label: 'Monitors', href: '/dashboard', icon: 'M3 12h4l2.5-6 5 12 2.5-6H21' },
  { id: 'incidents', label: 'Incidents', href: '/dashboard#incidents', icon: 'M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z' },
  { id: 'status', label: 'Status pages', href: '/dashboard/status-pages', icon: 'M3 3h18v18H3zM3 9h18M9 21V9' },
  { id: 'alerts', label: 'Alert contacts', href: '/dashboard/alerts', icon: 'M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.9 1.9 0 0 0 3.4 0' },
  { id: 'settings', label: 'Settings & billing', href: '/dashboard/settings', icon: 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-2.9 1.2V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-2.9-1.2l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1A1.7 1.7 0 0 0 3 14H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.2-2.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1A1.7 1.7 0 0 0 10 3V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 2.9 1.2l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1A1.7 1.7 0 0 0 21 10h.1a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.6 1Z' },
];
---
<Base title={`${title} · Dashboard`}>
  <div class="min-h-screen lg:grid lg:grid-cols-[15rem_1fr]">
    <!-- Sidebar (desktop) -->
    <aside class="hidden lg:flex flex-col border-r border-white/5 bg-ink-900/40 px-4 py-5 sticky top-0 h-screen">
      <div class="px-2"><Logo /></div>
      <a href="/dashboard/new" class="mt-7 flex items-center justify-center gap-2 rounded-lg bg-brand px-3 py-2 text-sm font-semibold text-ink-950 hover:bg-brand-soft transition-colors">
        <span class="text-base leading-none">+</span> New monitor
      </a>
      <nav class="mt-6 space-y-1">
        {nav.map((n) => (
          <a href={n.href} class:list={[
            'flex items-center gap-3 rounded-lg px-3 py-2 text-sm transition-colors',
            active === n.id ? 'bg-white/[0.06] text-white' : 'text-slate-400 hover:bg-white/[0.03] hover:text-white',
          ]}>
            <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={n.icon} /></svg>
            {n.label}
          </a>
        ))}
      </nav>
      <div class="mt-auto rounded-xl border border-white/10 bg-white/[0.02] p-4">
        <p class="text-xs text-slate-400">{plan.limits.name} plan · <span class="text-white">{used} / {plan.limits.monitors}</span> monitors</p>
        <div class="mt-2 h-1.5 rounded-full bg-white/5"><div class="h-full rounded-full bg-brand" style={`width:${usedPct}%`}></div></div>
        {plan.id !== 'business' && <a href="/pricing" class="mt-3 block text-xs font-semibold text-brand hover:text-brand-soft">Upgrade to {plan.id === 'free' ? 'Pro' : 'Business'} →</a>}
      </div>
      <div class="mt-4 flex items-center gap-3 px-2">
        <span class="grid size-8 place-items-center rounded-full bg-gradient-to-br from-brand to-emerald-700 text-xs font-bold text-ink-950">{initials}</span>
        <div class="min-w-0 text-xs"><p class="truncate text-white">{displayName}</p><p class="truncate text-slate-500">{user.email}</p></div>
      </div>
    </aside>

    <div class="min-w-0">
      <!-- Topbar (mobile) -->
      <header class="lg:hidden sticky top-0 z-40 flex h-14 items-center justify-between border-b border-white/5 bg-ink-950/80 px-4 backdrop-blur-xl">
        <Logo />
        <a href="/dashboard/new" class="rounded-lg bg-brand px-3 py-1.5 text-sm font-semibold text-ink-950">+ New</a>
      </header>
      <nav class="lg:hidden flex gap-1 overflow-x-auto border-b border-white/5 px-3 py-2 text-sm">
        {nav.map((n) => (
          <a href={n.href} class:list={['shrink-0 rounded-md px-3 py-1.5', active === n.id ? 'bg-white/[0.06] text-white' : 'text-slate-400']}>{n.label}</a>
        ))}
      </nav>

      <main class="mx-auto max-w-6xl px-4 sm:px-8 py-8">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
          <div>
            <h1 class="text-2xl font-semibold tracking-tight text-white">{title}</h1>
            {subtitle && <p class="mt-1 text-sm text-slate-400">{subtitle}</p>}
          </div>
          <slot name="actions" />
        </div>
        <slot />
      </main>
    </div>
  </div>
</Base>
