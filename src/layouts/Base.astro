---
import '../styles/global.css';
import { SITE } from '../site';
// Preload the main font so text renders in its final face immediately (no late swap).
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title?: string;          // full <title>; keep ≤ 60 characters, main keyword first
  description?: string;    // ≤ 155 characters
  noindex?: boolean;       // dashboards, auth pages, 404
  image?: string;          // OG image path (1200×630)
  jsonLd?: object[];       // extra structured data for this page
  breadcrumb?: { name: string; path: string }[];
}
const {
  title = `${SITE.name}: Free Website Uptime Monitoring & Status Pages`,
  description = SITE.description,
  noindex = false,
  image = '/og/default.png',
  jsonLd = [],
  breadcrumb,
} = Astro.props;

// Canonical always points at the real domain, without a trailing slash (except the home page).
const path = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
const canonical = new URL(path, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    logo: new URL('/apple-touch-icon.png', SITE.url).href,
    email: SITE.email,
  },
  ...(breadcrumb ? [{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Home', path: '/' }, ...breadcrumb].map((b, i) => ({
      '@type': 'ListItem', position: i + 1, name: b.name, item: new URL(b.path, SITE.url).href,
    })),
  }] : []),
  ...jsonLd,
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#05080f" />

    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}: website uptime monitoring and status pages`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    {SITE.gaId && !noindex && (
      <script is:inline define:vars={{ gaId: SITE.gaId, host: new URL(SITE.url).hostname }}>
        // Owner's own devices: open any page with ?notrack=1 once to stop counting this browser
        // (?notrack=0 turns it back on). Stored in localStorage, so it survives network/IP changes.
        var off = false;
        try {
          var nt = new URLSearchParams(location.search).get('notrack');
          if (nt === '1') localStorage.setItem('ur_notrack', '1');
          if (nt === '0') localStorage.removeItem('ur_notrack');
          off = localStorage.getItem('ur_notrack') === '1';
          if (nt === '1' || nt === '0') {
            var u = new URL(location.href); u.searchParams.delete('notrack');
            history.replaceState(null, '', u.pathname + u.search + u.hash);
            addEventListener('DOMContentLoaded', function () {
              var t = document.createElement('div');
              t.textContent = off ? 'Analytics off for this browser. Your visits won’t be counted.' : 'Analytics back on for this browser.';
              t.style.cssText = 'position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:9999;background:#111827;color:#fff;border:1px solid rgba(255,255,255,.15);padding:10px 16px;border-radius:10px;font:500 14px system-ui,sans-serif;box-shadow:0 10px 30px rgba(0,0,0,.5)';
              document.body.appendChild(t); setTimeout(function () { t.remove(); }, 4000);
            });
          }
        } catch (e) {}
        // Google Analytics loads only on the live domain, never in local dev.
        if (location.hostname === host && !off) {
          var s = document.createElement('script'); s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          gtag('js', new Date()); gtag('config', gaId);
        }
      </script>
    )}
  </head>
  <body>
    <slot />
    <script>
      // Reveal elements as they scroll into view.
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Flatten the tilted hero dashboard as the page scrolls.
      const tilt = document.querySelector<HTMLElement>('[data-tilt]');
      if (tilt && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const update = () => {
          const p = Math.min(1, Math.max(0, window.scrollY / 420));
          tilt.style.setProperty('--tilt', `${18 * (1 - p)}deg`);
          tilt.style.setProperty('--tilt-s', `${0.94 + 0.06 * p}`);
        };
        update();
        addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
      }
    </script>
  </body>
</html>
