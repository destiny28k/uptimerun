---
import '../styles/global.css';
import { SITE } from '../site';
const { title = `${SITE.name}: ${SITE.tagline}` } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      // Reveal elements as they scroll into view.
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Flatten the tilted hero dashboard as the page scrolls.
      const tilt = document.querySelector<HTMLElement>('[data-tilt]');
      if (tilt && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const update = () => {
          const p = Math.min(1, Math.max(0, window.scrollY / 420));
          tilt.style.setProperty('--tilt', `${18 * (1 - p)}deg`);
          tilt.style.setProperty('--tilt-s', `${0.94 + 0.06 * p}`);
        };
        update();
        addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
      }
    </script>
  </body>
</html>
