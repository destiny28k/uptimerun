---
// Comparison pages: /compare/<competitor>-alternative. Data lives in src/data/competitors.ts.
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { COMPETITORS, PRICES_CHECKED } from '../../data/competitors';
import { TOOLS } from '../../data/tools';

const c = COMPETITORS.find((x) => x.slug === Astro.params.slug);
if (!c) return Astro.rewrite('/404');
const path = `/compare/${c.slug}`;
const others = COMPETITORS.filter((x) => x.slug !== c.slug);

const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
}];
---
<Base title={c.title} description={c.description} jsonLd={jsonLd}
  breadcrumb={[{ name: 'Compare', path: '/compare' }, { name: c.heading, path }]}>
  <Navbar />
  <main>
    <section class="relative overflow-hidden border-b border-white/5">
      <div class="grid-bg absolute inset-0 pointer-events-none"></div>
      <div class="glow absolute inset-0 pointer-events-none"></div>
      <div class="relative mx-auto max-w-3xl px-4 sm:px-6 pt-16 pb-14 sm:pt-24 text-center">
        <nav class="text-xs text-slate-500"><a href="/compare" class="hover:text-slate-300">Compare</a> <span class="mx-1">/</span> <span class="text-slate-400">{c.name} alternative</span></nav>
        <h1 class="mt-4 text-3xl sm:text-5xl font-semibold tracking-tight text-white text-balance">{c.heading}</h1>
        <p class="mx-auto mt-4 max-w-xl text-slate-400 text-balance">{c.lead}</p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href="/signup" class="btn-primary rounded-xl px-6 py-3 text-sm font-semibold text-ink-950">Try UptimeRun free</a>
          <a href="/pricing" class="btn-ghost rounded-xl px-6 py-3 text-sm font-semibold text-white">See our pricing</a>
        </div>
      </div>
    </section>

    <article class="mx-auto max-w-4xl px-4 sm:px-6 py-16 space-y-5 text-[15px] leading-relaxed text-slate-400 [&_h2]:mt-12 [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-white [&_strong]:text-slate-200 [&_a]:text-brand [&_a:hover]:text-brand-soft">
      <h2 class="!mt-0">The short answer</h2>
      <p>{c.verdict}</p>

      <h2>UptimeRun vs {c.name}: feature and price comparison</h2>
      <div class="overflow-x-auto rounded-xl border border-white/10">
        <table class="w-full min-w-[560px] text-left text-sm">
          <thead class="bg-white/[0.03] text-slate-300">
            <tr><th class="px-4 py-3 font-semibold"></th><th class="px-4 py-3 font-semibold text-brand-soft">UptimeRun</th><th class="px-4 py-3 font-semibold">{c.name}</th></tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            {c.rows.map(([f, us, them]) => (
              <tr><td class="px-4 py-3 font-medium text-slate-200">{f}</td><td class="px-4 py-3">{us}</td><td class="px-4 py-3">{them}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-slate-500">Prices in USD per month, billed yearly, taken from each company’s public pricing page in {PRICES_CHECKED}. Prices change, so check their site before you decide.</p>

      <div class="grid gap-5 sm:grid-cols-2 !mt-12">
        <div class="rounded-2xl border border-brand/25 bg-brand/[0.04] p-6">
          <h3 class="font-semibold text-white">Where UptimeRun wins</h3>
          <ul class="mt-3 list-disc space-y-2 pl-5 text-sm">{c.weWin.map((w) => <li>{w}</li>)}</ul>
        </div>
        <div class="rounded-2xl border border-white/10 bg-ink-900/60 p-6">
          <h3 class="font-semibold text-white">Where {c.name} wins</h3>
          <ul class="mt-3 list-disc space-y-2 pl-5 text-sm">{c.theyWin.map((w) => <li>{w}</li>)}</ul>
        </div>
      </div>

      <h2>Which one should you choose?</h2>
      <p>{c.pickThem}</p>
      <p>
        UptimeRun’s <a href="/pricing">plans</a> start free for 10 websites with 5-minute checks. Pro adds 1-minute checks, 50 monitors, SSL and domain expiry alerts and <a href="/status/demo">status pages</a> on your own domain. Before you switch, try our free tools on your site: the <a href="/tools/website-down-checker">website down checker</a>, <a href="/tools/ssl-checker">SSL certificate checker</a>, <a href="/tools/domain-expiry-checker">domain expiry checker</a> and <a href="/tools/http-status-checker">HTTP status code checker</a>.
      </p>
    </article>

    <section class="border-t border-white/5 py-16">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <h2 class="text-2xl font-semibold tracking-tight text-white">Frequently asked questions</h2>
        <div class="mt-6 divide-y divide-white/5 rounded-2xl border border-white/10">
          {c.faqs.map(([q, a]) => (
            <details class="group px-6 py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-white">
                {q}<span class="text-slate-500 transition-transform group-open:rotate-45 text-xl leading-none">+</span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-slate-400">{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-white/5 py-16">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <h2 class="text-2xl font-semibold tracking-tight text-white">More comparisons</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          {others.map((o) => (
            <a href={`/compare/${o.slug}`} class="rounded-xl border border-white/10 bg-ink-900/60 p-5 hover:border-brand/40 transition-colors">
              <p class="font-semibold text-white">UptimeRun vs {o.name}</p>
              <p class="mt-1.5 text-sm text-slate-400">A cheaper {o.name} alternative: prices and features side by side.</p>
            </a>
          ))}
          <a href="/compare" class="rounded-xl border border-white/10 bg-ink-900/60 p-5 hover:border-brand/40 transition-colors">
            <p class="font-semibold text-white">All uptime monitors compared</p>
            <p class="mt-1.5 text-sm text-slate-400">Free plans and entry prices of popular uptime monitoring tools.</p>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
