---
// Demo of a customer's public status page (example data only).
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import { SITE } from '../../site';

type Day = { up: number; date: string }; // up = uptime % that day
const DAYS = 90;
const today = new Date('2026-11-23T00:00:00Z');
function history(bad: Record<number, number> = {}): Day[] {
  return Array.from({ length: DAYS }, (_, i) => {
    const d = new Date(today.getTime() - (DAYS - 1 - i) * 86_400_000);
    return { up: bad[i] ?? 100, date: d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }) };
  });
}
const avg = (h: Day[]) => (h.reduce((a, d) => a + d.up, 0) / h.length).toFixed(2);

const groups = [
  {
    name: 'Website',
    services: [
      { name: 'Homepage', history: history({ 61: 98.6 }) },
      { name: 'Online store', history: history({ 23: 99.1, 74: 97.2 }) },
    ],
  },
  {
    name: 'Platform',
    services: [
      { name: 'API', history: history() },
      { name: 'Customer dashboard', history: history({ 40: 99.4 }) },
      { name: 'Payments', history: history({ 74: 96.8 }) },
    ],
  },
];
const all = groups.flatMap((g) => g.services);
const overall = (all.reduce((a, s) => a + Number(avg(s.history)), 0) / all.length).toFixed(2);

const color = (up: number) => (up >= 99.9 ? 'bg-brand/80' : up >= 99 ? 'bg-amber-400/90' : 'bg-red-500/90');

const incidents = [
  {
    date: '21 Nov 2026', title: 'Slow checkout for some customers', impact: 'Minor', duration: '12 min',
    updates: [
      { status: 'Resolved', time: '14:32', text: 'Checkout is fast again. We’ll keep watching it closely.' },
      { status: 'Identified', time: '14:24', text: 'Our payment provider had a slowdown. A fix is rolling out.' },
      { status: 'Investigating', time: '14:20', text: 'Some customers see slow checkouts. We’re looking into it.' },
    ],
  },
  {
    date: '8 Nov 2026', title: 'Scheduled maintenance', impact: 'Maintenance', duration: '30 min',
    updates: [{ status: 'Completed', time: '02:30', text: 'Database upgrade finished with no downtime.' }],
  },
];
const statusTone: Record<string, string> = {
  Resolved: 'bg-brand/15 text-brand', Completed: 'bg-sky-500/15 text-sky-300',
  Identified: 'bg-amber-400/15 text-amber-300', Investigating: 'bg-red-500/15 text-red-300',
};
---
<Base title="My Shop Status · Demo">
  <!-- Demo bar: explains the page and gives a way back -->
  <div class="sticky top-0 z-50 border-b border-brand/20 bg-ink-900/90 backdrop-blur-xl">
    <div class="mx-auto flex max-w-4xl items-center justify-between gap-3 px-4 py-2.5 text-sm sm:px-6">
      <a href="/" class="inline-flex items-center gap-1.5 font-medium text-slate-300 hover:text-white">
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        Back<span class="hidden sm:inline"> to {SITE.name}</span>
      </a>
      <p class="hidden text-slate-400 md:block">This is a <span class="text-white">demo status page</span> with example data.</p>
      <a href="/signup" class="rounded-lg bg-brand px-3 py-1.5 text-xs font-semibold text-ink-950 hover:bg-brand-soft">Create yours free</a>
    </div>
  </div>

  <div class="relative overflow-hidden">
    <div class="grid-bg absolute inset-0 pointer-events-none"></div>
    <div class="glow absolute inset-0 pointer-events-none"></div>

    <div class="relative mx-auto max-w-4xl px-4 sm:px-6">
      <!-- Company header -->
      <header class="flex items-center justify-between gap-4 py-8">
        <div class="flex items-center gap-3">
          <span class="grid size-10 place-items-center rounded-xl bg-gradient-to-br from-white to-slate-300 text-sm font-bold text-ink-950 shadow-lg">MS</span>
          <div>
            <p class="font-semibold text-white">My Shop</p>
            <p class="text-xs text-slate-500">status.myshop.com</p>
          </div>
        </div>
        <button class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-3.5 py-2 text-sm font-medium text-white hover:bg-white/10">
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.9 1.9 0 0 0 3.4 0"/></svg>
          <span class="hidden sm:inline">Get updates</span>
        </button>
      </header>

      <!-- Overall status -->
      <section class="rounded-2xl border border-brand/30 bg-gradient-to-br from-brand/[0.12] via-brand/[0.04] to-transparent p-6 sm:p-8">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-4">
            <span class="relative grid size-12 shrink-0 place-items-center rounded-full bg-brand text-ink-950">
              <span class="absolute inset-0 animate-ping rounded-full bg-brand/40 motion-reduce:hidden"></span>
              <svg viewBox="0 0 24 24" class="relative size-6" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            </span>
            <div>
              <h1 class="text-xl sm:text-2xl font-semibold text-white">All systems operational</h1>
              <p class="text-sm text-slate-400">Updated a few seconds ago · checked every minute</p>
            </div>
          </div>
          <dl class="grid grid-cols-3 gap-6 text-center sm:text-right">
            <div><dt class="text-xs text-slate-500">Uptime (90d)</dt><dd class="mt-1 text-lg font-semibold tabular-nums text-white">{overall}%</dd></div>
            <div><dt class="text-xs text-slate-500">Avg response</dt><dd class="mt-1 text-lg font-semibold tabular-nums text-white">182 ms</dd></div>
            <div><dt class="text-xs text-slate-500">Incidents</dt><dd class="mt-1 text-lg font-semibold tabular-nums text-white">2</dd></div>
          </dl>
        </div>
      </section>

      <!-- Services -->
      <div class="mt-10 flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-lg font-semibold text-white">Services</h2>
        <div class="flex items-center gap-4 text-xs text-slate-400">
          <span class="flex items-center gap-1.5"><span class="size-2.5 rounded-sm bg-brand/80"></span>Up</span>
          <span class="flex items-center gap-1.5"><span class="size-2.5 rounded-sm bg-amber-400/90"></span>Partial</span>
          <span class="flex items-center gap-1.5"><span class="size-2.5 rounded-sm bg-red-500/90"></span>Outage</span>
        </div>
      </div>

      <div class="mt-4 space-y-5">
        {groups.map((g) => (
          <section class="overflow-hidden rounded-2xl border border-white/10 bg-ink-900/60 backdrop-blur">
            <p class="border-b border-white/5 bg-white/[0.02] px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-400">{g.name}</p>
            <div class="divide-y divide-white/5">
              {g.services.map((s) => (
                <div class="px-5 py-5">
                  <div class="flex items-center justify-between gap-3 text-sm">
                    <span class="flex items-center gap-2 font-medium text-white">
                      <svg viewBox="0 0 24 24" class="size-4 text-brand" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                      {s.name}
                    </span>
                    <span class="text-xs tabular-nums text-slate-400"><span class="text-slate-200">{avg(s.history)}%</span> uptime</span>
                  </div>
                  <!-- 90 bars on desktop, last 45 on phones -->
                  <div class="mt-3 flex h-9 items-stretch gap-[2px]">
                    {s.history.map((d, i) => (
                      <span title={`${d.date}: ${d.up}% uptime`}
                        class:list={['group/bar relative flex-1 rounded-[2px] transition-opacity hover:opacity-70', color(d.up), i < DAYS - 45 && 'hidden sm:block']}>
                        <span class="pointer-events-none absolute bottom-full left-1/2 z-10 mb-2 hidden -translate-x-1/2 whitespace-nowrap rounded-md border border-white/10 bg-ink-800 px-2 py-1 text-[11px] text-white shadow-xl group-hover/bar:block">
                          {d.date} · {d.up === 100 ? 'No downtime' : `${d.up}% uptime`}
                        </span>
                      </span>
                    ))}
                  </div>
                  <div class="mt-2 flex justify-between text-[11px] text-slate-600">
                    <span><span class="hidden sm:inline">90</span><span class="sm:hidden">45</span> days ago</span><span>Today</span>
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

      <!-- Incident history -->
      <h2 class="mt-14 text-lg font-semibold text-white">Past incidents</h2>
      <div class="mt-4 space-y-4">
        {incidents.map((inc) => (
          <article class="rounded-2xl border border-white/10 bg-ink-900/60 p-5 sm:p-6">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <p class="text-xs text-slate-500">{inc.date} · lasted {inc.duration}</p>
                <h3 class="mt-1 font-semibold text-white">{inc.title}</h3>
              </div>
              <span class:list={['rounded-full px-2.5 py-1 text-xs font-medium', inc.impact === 'Maintenance' ? 'bg-sky-500/15 text-sky-300' : 'bg-amber-400/15 text-amber-300']}>{inc.impact}</span>
            </div>
            <ol class="mt-5 space-y-4 border-l border-white/10 pl-5">
              {inc.updates.map((u) => (
                <li class="relative">
                  <span class="absolute -left-[25px] top-1.5 size-2.5 rounded-full border-2 border-ink-900 bg-slate-500"></span>
                  <p class="text-sm"><span class:list={['mr-2 rounded px-1.5 py-0.5 text-xs font-semibold', statusTone[u.status]]}>{u.status}</span><span class="text-xs text-slate-500">{u.time} UTC</span></p>
                  <p class="mt-1.5 text-sm text-slate-300">{u.text}</p>
                </li>
              ))}
            </ol>
          </article>
        ))}
        <p class="text-center text-sm text-slate-500">No other incidents in the last 90 days.</p>
      </div>

      <footer class="mt-16 flex flex-col items-center gap-3 border-t border-white/5 py-10 text-center">
        <p class="text-xs text-slate-500">Powered by</p>
        <Logo />
        <a href="/signup" class="text-sm font-medium text-brand hover:text-brand-soft">Get a free status page for your site →</a>
      </footer>
    </div>
  </div>
</Base>
