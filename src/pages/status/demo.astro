---
// Demo of a customer's public status page (example data only).
import Base from '../../layouts/Base.astro';
import StatusPageView from '../../components/status/StatusPageView.astro';
import { SITE } from '../../site';
import type { Day, StatusPageData } from '../../lib/statusPage';

const DAYS = 90;
const today = new Date('2026-11-23T00:00:00Z').getTime();
function history(bad: Record<number, number> = {}): Day[] {
  return Array.from({ length: DAYS }, (_, i) => ({
    up: bad[i] ?? 100,
    date: new Date(today - (DAYS - 1 - i) * 86_400_000).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }),
  }));
}
const avg = (h: Day[]) => `${(h.reduce((a, d) => a + (d.up ?? 100), 0) / h.length).toFixed(2)}%`;
const svc = (name: string, days: Day[]) => ({ name, status: 'up' as const, uptime: avg(days), days });

const data: StatusPageData = {
  title: 'My Shop',
  subtitle: 'status.myshop.com',
  overall: { state: 'ok', label: 'All systems operational', note: 'Updated a few seconds ago · checked every minute' },
  stats: { uptime: '99.98%', avgMs: '182 ms', incidents: 2 },
  groups: [
    { name: 'Website', services: [svc('Homepage', history({ 61: 98.6 })), svc('Online store', history({ 23: 99.1, 74: 97.2 }))] },
    { name: 'Platform', services: [svc('API', history()), svc('Customer dashboard', history({ 40: 99.4 })), svc('Payments', history({ 74: 96.8 }))] },
  ],
  incidents: [
    {
      date: '21 Nov 2026', title: 'Slow checkout for some customers', impact: 'Minor', duration: 'lasted 12 min',
      updates: [
        { status: 'Resolved', time: '14:32 UTC', text: 'Checkout is fast again. We’ll keep watching it closely.' },
        { status: 'Identified', time: '14:24 UTC', text: 'Our payment provider had a slowdown. A fix is rolling out.' },
        { status: 'Investigating', time: '14:20 UTC', text: 'Some customers see slow checkouts. We’re looking into it.' },
      ],
    },
    {
      date: '8 Nov 2026', title: 'Scheduled maintenance', impact: 'Maintenance', duration: 'lasted 30 min',
      updates: [{ status: 'Completed', time: '02:30 UTC', text: 'Database upgrade finished with no downtime.' }],
    },
  ],
  branding: true,
};
---
<Base title="Free Status Page Example | UptimeRun" description="See a live example of a free public status page made with UptimeRun: uptime bars, incident history and automatic outage updates." breadcrumb={[{ name: 'Status page example', path: '/status/demo' }]}>
  <!-- Demo bar: explains the page and gives a way back -->
  <div class="sticky top-0 z-50 border-b border-brand/20 bg-ink-900/90 backdrop-blur-xl">
    <div class="mx-auto flex max-w-4xl items-center justify-between gap-3 px-4 py-2.5 text-sm sm:px-6">
      <a href="/" class="inline-flex items-center gap-1.5 font-medium text-slate-300 hover:text-white">
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        Back<span class="hidden sm:inline"> to {SITE.name}</span>
      </a>
      <p class="hidden text-slate-400 md:block">This is a <span class="text-white">demo status page</span> with example data.</p>
      <a href="/signup" class="rounded-lg bg-brand px-3 py-1.5 text-xs font-semibold text-ink-950 hover:bg-brand-soft">Create yours free</a>
    </div>
  </div>
  <StatusPageView data={data} />
</Base>
