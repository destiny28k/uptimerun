---
import Dashboard from '../../layouts/Dashboard.astro';
const pages = [
  { name: 'My Shop status', url: 'status.myshop.com', monitors: 3, visits: '1.2K', custom: true },
  { name: 'Client: Studio', url: 'upbeat.page/studio', monitors: 2, visits: '86', custom: false },
];
---
<Dashboard title="Status pages" active="status" subtitle="Public pages that keep your customers informed.">
  <a slot="actions" href="#" class="rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-ink-950 hover:bg-brand-soft">+ New status page</a>

  <p class="mb-6 rounded-xl border border-amber-400/30 bg-amber-400/[0.07] px-4 py-3 text-sm text-amber-200">Preview: status pages are coming soon. The cards below are examples.</p>
  <div class="grid gap-5 md:grid-cols-2">
    {pages.map((p) => (
      <div class="overflow-hidden rounded-xl border border-white/10 bg-ink-900/50">
        <div class="border-b border-white/5 bg-gradient-to-br from-brand/10 to-transparent p-6">
          <div class="rounded-lg border border-white/10 bg-ink-950/80 p-4">
            <p class="text-xs text-slate-500">{p.url}</p>
            <p class="mt-2 flex items-center gap-2 text-sm font-medium text-white"><span class="size-2 rounded-full bg-brand"></span> All systems operational</p>
            <div class="mt-3 flex h-4 gap-[2px]">{Array.from({ length: 45 }).map(() => <span class="flex-1 rounded-[1px] bg-brand/60"></span>)}</div>
          </div>
        </div>
        <div class="flex items-center justify-between gap-4 p-5">
          <div>
            <p class="font-medium text-white">{p.name}</p>
            <p class="text-xs text-slate-500">{p.monitors} monitors · {p.visits} visits this month {p.custom && '· Custom domain'}</p>
          </div>
          <div class="flex gap-2">
            <a href="/status/demo" class="rounded-lg border border-white/10 px-3 py-1.5 text-xs font-medium text-slate-300 hover:bg-white/5">View</a>
            <button class="rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-medium text-white hover:bg-white/10">Edit</button>
          </div>
        </div>
      </div>
    ))}
  </div>
</Dashboard>
