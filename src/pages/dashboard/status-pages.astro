---
import { env } from 'cloudflare:workers';
import Dashboard from '../../layouts/Dashboard.astro';
import { FREE_STATUS_PAGE_LIMIT, slugError, slugify, type StatusPageRow } from '../../lib/statusPage';

const user = Astro.locals.user!;
let error = '';
let values = { title: '', slug: '' };

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  values = { title: String(f.get('title') ?? '').trim().slice(0, 60), slug: slugify(String(f.get('slug') ?? '') || String(f.get('title') ?? '')) };
  const count = await env.DB.prepare(`SELECT COUNT(*) AS n FROM status_pages WHERE user_id = ?`).bind(user.id).first<{ n: number }>();
  const taken = await env.DB.prepare(`SELECT 1 FROM status_pages WHERE slug = ?`).bind(values.slug).first();

  if (!values.title) error = 'Give your status page a name, like your company or website name.';
  else if (slugError(values.slug)) error = slugError(values.slug)!;
  else if (taken) error = `The address “${values.slug}” is already taken. Try another.`;
  else if ((count?.n ?? 0) >= FREE_STATUS_PAGE_LIMIT) error = `The free plan includes ${FREE_STATUS_PAGE_LIMIT} status page. Upgrade to create more.`;
  else {
    const id = crypto.randomUUID();
    await env.DB.prepare(`INSERT INTO status_pages (id, user_id, slug, title, created_at) VALUES (?, ?, ?, ?, ?)`)
      .bind(id, user.id, values.slug, values.title, Date.now()).run();
    // Start with all the user's monitors on the page; they can untick any later.
    await env.DB.prepare(
      `INSERT INTO status_page_monitors (page_id, monitor_id, position)
       SELECT ?, id, ROW_NUMBER() OVER (ORDER BY created_at) FROM monitors WHERE user_id = ?`,
    ).bind(id, user.id).run();
    return Astro.redirect(`/dashboard/status-page?id=${id}&created=1`, 303);
  }
}

const { results: pages } = await env.DB.prepare(
  `SELECT p.*, (SELECT COUNT(*) FROM status_page_monitors s WHERE s.page_id = p.id) AS monitors,
          (SELECT COUNT(*) FROM status_page_monitors s JOIN monitors m ON m.id = s.monitor_id WHERE s.page_id = p.id AND m.status = 'down') AS down
   FROM status_pages p WHERE p.user_id = ? ORDER BY p.created_at`,
).bind(user.id).all<StatusPageRow & { monitors: number; down: number }>();

const host = Astro.url.host;
const input = 'w-full rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2.5 text-sm text-white placeholder:text-slate-500 outline-none focus:border-brand/50';
const canCreate = pages.length < FREE_STATUS_PAGE_LIMIT;
---
<Dashboard title="Status pages" active="status" subtitle="Public pages that show your customers what’s up, and what’s down.">
  {pages.length > 0 && (
    <div class="grid gap-5 md:grid-cols-2">
      {pages.map((p) => (
        <div class="overflow-hidden rounded-xl border border-white/10 bg-ink-900/50">
          <div class="border-b border-white/5 bg-gradient-to-br from-brand/10 to-transparent p-6">
            <div class="rounded-lg border border-white/10 bg-ink-950/80 p-4">
              <p class="truncate text-xs text-slate-500">{host}/s/{p.slug}</p>
              <p class="mt-2 flex items-center gap-2 text-sm font-medium text-white">
                <span class:list={['size-2 rounded-full', p.down ? 'bg-red-500' : 'bg-brand']}></span>
                {p.monitors === 0 ? 'No services yet' : p.down ? `${p.down} service${p.down > 1 ? 's' : ''} down` : 'All systems operational'}
              </p>
            </div>
          </div>
          <div class="flex flex-wrap items-center justify-between gap-4 p-5">
            <div class="min-w-0">
              <p class="truncate font-medium text-white">{p.title}</p>
              <p class="text-xs text-slate-500">{p.monitors} monitor{p.monitors === 1 ? '' : 's'} shown</p>
            </div>
            <div class="flex gap-2">
              <a href={`/s/${p.slug}`} target="_blank" rel="noopener" class="rounded-lg border border-white/10 px-3 py-1.5 text-xs font-medium text-slate-300 hover:bg-white/5">View ↗</a>
              <a href={`/dashboard/status-page?id=${p.id}`} class="rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-medium text-white hover:bg-white/10">Edit</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  )}

  {canCreate ? (
    <form method="post" class:list={['rounded-xl border border-white/10 bg-ink-900/50 p-6', pages.length > 0 && 'mt-8']}>
      <h2 class="font-semibold text-white">{pages.length ? 'Create another status page' : 'Create your status page'}</h2>
      <p class="mt-1 text-sm text-slate-400">It goes live instantly, and we add all your monitors to it. You can choose which ones to show afterwards.</p>
      {error && <p class="mt-4 rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-300">{error}</p>}
      <div class="mt-5 grid gap-5 sm:grid-cols-2">
        <div>
          <label for="title" class="mb-2 block text-sm font-medium text-white">Page name</label>
          <input id="title" name="title" required maxlength="60" value={values.title} class={input} placeholder="My Shop" />
        </div>
        <div>
          <label for="slug" class="mb-2 block text-sm font-medium text-white">Address</label>
          <div class="flex items-center overflow-hidden rounded-lg border border-white/10 bg-white/[0.03] focus-within:border-brand/50">
            <span class="shrink-0 pl-3 text-sm text-slate-500">{host}/s/</span>
            <input id="slug" name="slug" maxlength="40" value={values.slug} class="w-full bg-transparent px-1 py-2.5 text-sm text-white placeholder:text-slate-500 outline-none" placeholder="my-shop" />
          </div>
          <p class="mt-1.5 text-xs text-slate-500">Leave empty to use the page name.</p>
        </div>
      </div>
      <button class="mt-6 rounded-lg bg-brand px-5 py-2.5 text-sm font-semibold text-ink-950 hover:bg-brand-soft">Create status page</button>
    </form>
  ) : (
    <div class="mt-8 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-white/10 bg-white/[0.02] px-5 py-4">
      <p class="text-sm text-slate-400">The free plan includes {FREE_STATUS_PAGE_LIMIT} status page. Pro gives you 3, on your own domain.</p>
      <a href="/pricing" class="rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-ink-950 hover:bg-brand-soft">See plans</a>
    </div>
  )}
</Dashboard>
