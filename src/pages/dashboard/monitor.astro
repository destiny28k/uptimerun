---
import { env } from 'cloudflare:workers';
import Dashboard from '../../layouts/Dashboard.astro';
import StatusDot from '../../components/dash/StatusDot.astro';
import UptimeBars from '../../components/dash/UptimeBars.astro';
import { getMonitor, periodStats, listIncidents, toBars, intervalLabel, ago, fmtDate, fmtUptime } from '../../lib/data';
import { formatDuration, sendAlerts } from '../../lib/alerts';

const user = Astro.locals.user!;
const id = Astro.url.searchParams.get('id') ?? '';

// Pause / resume / delete
if (Astro.request.method === 'POST') {
  const action = String((await Astro.request.formData()).get('action'));
  if (action === 'delete') {
    await env.DB.prepare(`DELETE FROM monitors WHERE id = ? AND user_id = ?`).bind(id, user.id).run();
    return Astro.redirect('/dashboard', 303);
  }
  if (action === 'pause') {
    await env.DB.prepare(`UPDATE monitors SET status = 'paused', fail_count = 0, status_since = ? WHERE id = ? AND user_id = ?`).bind(Date.now(), id, user.id).run();
    await env.DB.prepare(`UPDATE incidents SET resolved_at = ? WHERE monitor_id = ? AND resolved_at IS NULL`).bind(Date.now(), id).run();
  }
  if (action === 'test') {
    const row = await getMonitor(env.DB, user.id, id);
    if (row) await sendAlerts(env, [{ userId: user.id, monitorName: row.name, url: row.url, kind: 'test' }]);
    return Astro.redirect(`/dashboard/monitor?id=${id}&tested=1`, 303);
  }
  if (action === 'resume') {
    await env.DB.prepare(`UPDATE monitors SET status = 'pending', next_check_at = 0, status_since = ? WHERE id = ? AND user_id = ?`).bind(Date.now(), id, user.id).run();
  }
  return Astro.redirect(`/dashboard/monitor?id=${id}`, 303);
}

const m = await getMonitor(env.DB, user.id, id);
if (!m) return Astro.redirect('/dashboard');

const [d1, d7, d30, incidents] = await Promise.all([
  periodStats(env.DB, m.id, 1), periodStats(env.DB, m.id, 7), periodStats(env.DB, m.id, 30), listIncidents(env.DB, user.id, m.id, 5),
]);

const periods = [
  { label: 'Today (UTC)', s: d1 }, { label: 'Last 7 days', s: d7 }, { label: 'Last 30 days', s: d30 },
];

// Response-time chart from the last 60 successful checks.
const times = m.ms_history.split(',').map(Number).filter((n) => n > 0);
const W = 600, H = 160;
const max = Math.max(200, ...times) * 1.15;
const pts = times.map((v, i) => [(i / Math.max(1, times.length - 1)) * W, H - (v / max) * H]);
const line = pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
const area = pts.length ? `${line} L${W},${H} L0,${H} Z` : '';
const avg = times.length ? Math.round(times.reduce((a, b) => a + b, 0) / times.length) : null;

const badge = {
  up: { text: `Up for ${formatDuration(Date.now() - (m.status_since ?? m.created_at))}`, cls: 'bg-brand/10 text-brand' },
  down: { text: `Down for ${formatDuration(Date.now() - (m.status_since ?? m.created_at))}`, cls: 'bg-red-500/15 text-red-300' },
  pending: { text: 'Waiting for first check', cls: 'bg-amber-400/10 text-amber-300' },
  paused: { text: 'Paused', cls: 'bg-white/5 text-slate-400' },
}[m.status];
// Domain & SSL expiry (checked once a day).
const isHttps = m.url.startsWith('https:');
const expiryRows = [
  { label: 'SSL certificate', at: m.ssl_expires_at, extra: m.ssl_issuer, na: isHttps ? 'Not found yet' : 'Not HTTPS' },
  { label: 'Domain', at: m.domain_expires_at, extra: null, na: 'Not published by this domain’s registry' },
].map((r) => {
  const days = r.at ? Math.ceil((r.at - Date.now()) / 86_400_000) : null;
  const tone = days == null ? 'text-slate-400' : days <= 7 ? 'text-red-300' : days <= 30 ? 'text-amber-300' : 'text-brand';
  const left = days == null ? '' : days > 0 ? `${days} days left` : 'Expired';
  return { ...r, days, tone, left, date: r.at ? new Date(r.at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) : '' };
});
const expiryPending = !m.expiry_checked_at;
const btn = 'rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-white hover:bg-white/10';
---
<Dashboard title={m.name} active="monitors">
  <div slot="actions" class="flex flex-wrap gap-2">
    <form method="post"><button name="action" value="test" class={btn} title="Send a test alert to your alert contacts">Send test alert</button></form>
    <a href={`/dashboard/edit?id=${m.id}`} class={btn}>Edit</a>
    <form method="post"><button name="action" value={m.status === 'paused' ? 'resume' : 'pause'} class={btn}>{m.status === 'paused' ? 'Resume' : 'Pause'}</button></form>
    <form method="post" onsubmit="return confirm('Delete this monitor and its history? This can’t be undone.')">
      <button name="action" value="delete" class="rounded-lg border border-red-500/30 px-4 py-2 text-sm font-medium text-red-300 hover:bg-red-500/10">Delete</button>
    </form>
  </div>

  <div class="-mt-6 mb-8 flex flex-wrap items-center gap-3 text-sm">
    <span class:list={['inline-flex items-center gap-2 rounded-full px-3 py-1 font-medium', badge.cls]}><StatusDot status={m.status} size="size-2" /> {badge.text}</span>
    <a href={m.url} target="_blank" rel="noopener" class="truncate text-slate-400 hover:text-white">{m.url} ↗</a>
    <span class="text-slate-600">·</span>
    <span class="text-slate-400">{m.type === 'keyword' ? `Keyword "${m.keyword}"` : 'HTTPS'} check every {intervalLabel(m.interval_sec)}</span>
  </div>

  {Astro.url.searchParams.get('tested') && (
    <p class="mb-6 rounded-xl border border-brand/30 bg-brand/10 px-4 py-3 text-sm text-brand">Test alert sent to your alert contacts. Check your inbox or chat app.</p>
  )}
  {m.status === 'down' && m.last_error && (
    <p class="mb-6 rounded-xl border border-red-500/30 bg-red-500/[0.07] px-4 py-3 text-sm text-red-200">Last error: <span class="font-semibold">{m.last_error}</span></p>
  )}

  <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    {periods.map((p) => (
      <div class="rounded-xl border border-white/10 bg-ink-900/50 p-5">
        <p class="text-xs text-slate-500">{p.label}</p>
        <p class="mt-2 text-2xl font-semibold tabular-nums text-white">{fmtUptime(p.s.uptime)}</p>
        <p class="mt-1 text-xs text-slate-500">{p.s.checks ? `${p.s.checks} checks` : 'No data yet'}</p>
      </div>
    ))}
    <div class="rounded-xl border border-white/10 bg-ink-900/50 p-5">
      <p class="text-xs text-slate-500">Last check</p>
      <p class="mt-2 text-2xl font-semibold tabular-nums text-white">{m.last_ms ? `${m.last_ms} ms` : '—'}</p>
      <p class="mt-1 text-xs text-slate-500">{ago(m.last_checked_at)}</p>
    </div>
  </div>

  <div class="mt-6 rounded-xl border border-white/10 bg-ink-900/50 p-5">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 class="font-semibold text-white">Domain & SSL</h2>
      <span class="text-xs text-slate-500">{expiryPending ? 'First check runs within a few minutes' : `Checked ${ago(m.expiry_checked_at)} · we alert 30, 14, 7 and 1 day before expiry`}</span>
    </div>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {expiryRows.map((r) => (
        <div class="rounded-lg border border-white/5 bg-white/[0.02] px-4 py-3">
          <p class="text-xs text-slate-500">{r.label}</p>
          {r.days != null ? (
            <>
              <p class:list={['mt-1 text-lg font-semibold tabular-nums', r.tone]}>{r.left}</p>
              <p class="text-xs text-slate-500">Expires {r.date}{r.extra ? ` · ${r.extra}` : ''}</p>
            </>
          ) : (
            <p class="mt-1 text-sm text-slate-400">{expiryPending ? 'Checking…' : r.na}</p>
          )}
        </div>
      ))}
    </div>
  </div>

  <div class="mt-6 rounded-xl border border-white/10 bg-ink-900/50 p-5">
    <h2 class="font-semibold text-white">Response time</h2>
    <p class="text-xs text-slate-500">{avg ? <>Average <span class="text-slate-300">{avg} ms</span> · min {Math.min(...times)} ms · max {Math.max(...times)} ms · last {times.length} checks</> : 'The chart appears after the first few checks.'}</p>
    {pts.length > 1 ? (
      <svg viewBox={`0 0 ${W} ${H}`} class="mt-5 h-44 w-full" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="rt" x1="0" x2="0" y1="0" y2="1">
            <stop offset="0%" stop-color="#22c55e" stop-opacity="0.35" />
            <stop offset="100%" stop-color="#22c55e" stop-opacity="0" />
          </linearGradient>
        </defs>
        {[0.25, 0.5, 0.75].map((f) => <line x1="0" x2={W} y1={H * f} y2={H * f} stroke="rgb(255 255 255 / 0.05)" />)}
        <path d={area} fill="url(#rt)" />
        <path d={line} fill="none" stroke="#22c55e" stroke-width="2" vector-effect="non-scaling-stroke" />
      </svg>
    ) : (
      <div class="mt-5 grid h-44 place-items-center rounded-lg border border-dashed border-white/10 text-sm text-slate-500">Collecting data…</div>
    )}
  </div>

  <div class="mt-6 rounded-xl border border-white/10 bg-ink-900/50 p-5">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 class="font-semibold text-white">Last 60 checks</h2>
      <span class="text-xs text-slate-500">Grey = no data yet · down is confirmed by 2 failed checks in a row</span>
    </div>
    <div class="mt-4"><UptimeBars history={toBars(m.history)} height="h-10" /></div>
  </div>

  <div class="mt-6 rounded-xl border border-white/10 bg-ink-900/50 p-5">
    <h2 class="font-semibold text-white">Incident history</h2>
    {incidents.length === 0 ? <p class="mt-3 text-sm text-slate-400">No incidents. 🎉</p> : (
      <ul class="mt-4 space-y-3 text-sm">
        {incidents.map((i) => (
          <li class="flex items-start justify-between gap-4">
            <div><p class="text-white">{i.cause}</p><p class="text-xs text-slate-500">{fmtDate(i.started_at)}</p></div>
            <span class:list={['shrink-0 rounded-full px-2 py-0.5 text-xs', i.resolved_at ? 'bg-brand/10 text-brand' : 'bg-red-500/15 text-red-300']}>
              {i.resolved_at ? formatDuration(i.resolved_at - i.started_at) : 'Ongoing'}
            </span>
          </li>
        ))}
      </ul>
    )}
  </div>
</Dashboard>
