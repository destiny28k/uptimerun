---
import { env } from 'cloudflare:workers';
import Dashboard from '../../layouts/Dashboard.astro';
import { countMonitors, intervalLabel } from '../../lib/data';
import { PLANS } from '../../data/plans';

const user = Astro.locals.user!;
const { id: planId, limits } = Astro.locals.plan!;
const sub = await env.DB.prepare(`SELECT billing, status, current_period_end, provider_customer_id FROM user_plans WHERE user_id = ?`).bind(user.id).first<{ billing: string | null; status: string; current_period_end: number | null; provider_customer_id: string | null }>();
const flag = Astro.url.searchParams;
const billingMsg = flag.get('upgraded') ? ['ok', 'Payment received. Your plan updates within a few seconds. Refresh if it hasn’t yet.']
  : flag.get('billing') === 'error' ? ['err', 'We couldn’t open checkout. Please try again or email us.']
  : flag.get('billing') === 'soon' ? ['err', 'Online payment is being set up. Please check back shortly.'] : null;
const renewDate = sub?.current_period_end ? new Date(sub.current_period_end).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : null;
const [used, channels, pages] = await Promise.all([
  countMonitors(env.DB, user.id),
  env.DB.prepare(`SELECT COUNT(*) AS n FROM alert_channels WHERE user_id = ?`).bind(user.id).first<{ n: number }>(),
  env.DB.prepare(`SELECT COUNT(*) AS n FROM status_pages WHERE user_id = ?`).bind(user.id).first<{ n: number }>(),
]);
const usage = [
  { label: 'Monitors', used, max: limits.monitors },
  { label: 'Status pages', used: pages?.n ?? 0, max: limits.statusPages },
  { label: 'Alert contacts', used: channels?.n ?? 0, max: 10 },
];
const current = PLANS.find((p) => p.id === planId)!;
const next = planId === 'free' ? PLANS[1] : planId === 'pro' ? PLANS[2] : null;
---
<Dashboard title="Settings & billing" active="settings">
  {billingMsg && <p class:list={['mb-6 rounded-lg border px-4 py-3 text-sm', billingMsg[0] === 'ok' ? 'border-brand/30 bg-brand/10 text-brand' : 'border-amber-400/30 bg-amber-400/10 text-amber-200']}>{billingMsg[1]}</p>}
  <div class="grid gap-6 lg:grid-cols-[1fr_22rem]">
    <div class="space-y-6">
      <section class="rounded-xl border border-white/10 bg-ink-900/50 p-6">
        <h2 class="font-semibold text-white">Account</h2>
        <dl class="mt-5 grid gap-5 sm:grid-cols-2 text-sm">
          <div><dt class="text-slate-500">Name</dt><dd class="mt-1 text-white">{user.name || '—'}</dd></div>
          <div><dt class="text-slate-500">Email</dt><dd class="mt-1 text-white">{user.email}</dd></div>
        </dl>
        <button id="sign-out" class="mt-6 rounded-lg bg-white/10 px-4 py-2 text-sm font-medium text-white hover:bg-white/15">Log out</button>
      </section>

      <section class="rounded-xl border border-white/10 bg-ink-900/50 p-6">
        <h2 class="font-semibold text-white">Usage</h2>
        <div class="mt-5 space-y-5">
          {usage.map((u) => {
            const unlimited = u.max >= 1000;
            const pct = unlimited ? 5 : Math.min(100, Math.round((u.used / u.max) * 100));
            return (
              <div>
                <div class="flex justify-between text-sm"><span class="text-slate-300">{u.label}</span><span class="tabular-nums text-slate-400">{u.used} / {unlimited ? 'Unlimited' : u.max}</span></div>
                <div class="mt-2 h-1.5 rounded-full bg-white/5"><div class:list={['h-full rounded-full', pct >= 100 ? 'bg-amber-400' : 'bg-brand']} style={`width:${pct}%`}></div></div>
              </div>
            );
          })}
        </div>
      </section>
    </div>

    <aside class="h-fit rounded-xl border border-brand/40 bg-gradient-to-b from-brand/[0.08] to-transparent p-6">
      <p class="text-xs font-semibold uppercase tracking-wider text-brand">Current plan</p>
      <p class="mt-2 text-2xl font-semibold text-white">{limits.name}</p>
      <p class="mt-1 text-sm text-slate-400">{limits.monitors} monitors · checks every {intervalLabel(limits.minIntervalSec)}</p>
      <ul class="mt-4 space-y-1.5 text-sm text-slate-300">
        {current.highlights.slice(2, 5).map((h) => <li class="flex gap-2"><span class="text-brand">✓</span>{h}</li>)}
      </ul>
      {sub?.provider_customer_id && planId !== 'free' && (
        <div class="mt-4 text-sm">
          <p class="text-slate-400">{sub.status === 'cancelled' ? `Cancelled · access until ${renewDate}` : sub.status === 'past_due' ? 'Payment failed · please update your card' : `Billed ${sub.billing} · renews ${renewDate}`}</p>
          <a href="/api/billing/portal" class="mt-3 block w-full rounded-lg border border-white/15 py-2.5 text-center font-semibold text-white hover:bg-white/5">Manage billing</a>
        </div>
      )}
      {next && (
        <div class="mt-6 rounded-lg border border-white/10 bg-ink-950/60 p-4">
          <p class="font-medium text-white">Upgrade to {next.name}</p>
          <p class="mt-1 text-sm text-slate-400">{next.highlights.slice(0, 3).join(' · ')}</p>
          <p class="mt-4"><span class="text-3xl font-semibold text-white">${next.monthly}</span><span class="text-sm text-slate-500"> / month</span></p>
          <p class="text-xs text-slate-500">or ${next.yearly} / year</p>
          <a href="/pricing" class="mt-4 block w-full rounded-lg bg-brand py-2.5 text-center text-sm font-semibold text-ink-950 hover:bg-brand-soft">See plans</a>
          <p class="mt-2 text-center text-xs text-slate-500">Secure checkout · Cancel any time</p>
        </div>
      )}
    </aside>
  </div>
</Dashboard>

<script>
  document.getElementById('sign-out')?.addEventListener('click', async () => {
    await fetch('/api/auth/sign-out', { method: 'POST', headers: { 'content-type': 'application/json' }, body: '{}' });
    location.href = '/';
  });
</script>
