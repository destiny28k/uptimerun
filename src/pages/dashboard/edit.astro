---
import { env } from 'cloudflare:workers';
import Dashboard from '../../layouts/Dashboard.astro';
import MonitorForm from '../../components/dash/MonitorForm.astro';
import { readForm, validate, type MonitorValues } from '../../lib/monitorForm';

const user = Astro.locals.user!;
const id = Astro.url.searchParams.get('id') ?? '';
const m = await env.DB.prepare(`SELECT * FROM monitors WHERE id = ? AND user_id = ?`).bind(id, user.id).first<any>();
if (!m) return Astro.redirect('/dashboard');

let error = '';
let values: MonitorValues = {
  type: m.type, url: m.url, name: m.name, keyword: m.keyword ?? '', interval: String(m.interval_sec),
  timeout: String(m.timeout_sec), method: m.method, follow: String(m.follow_redirects),
};

if (Astro.request.method === 'POST') {
  values = readForm(await Astro.request.formData());
  const result = validate(values, Astro.locals.plan!.limits.minIntervalSec);
  if (result.error) error = result.error;
  else {
    const d = result.data!;
    // If what we check changed, start fresh so old results don't mislead.
    const changed = d.url !== m.url || d.type !== m.type || d.keyword !== m.keyword;
    await env.DB.prepare(
      `UPDATE monitors SET name = ?, url = ?, type = ?, keyword = ?, interval_sec = ?, timeout_sec = ?, method = ?, follow_redirects = ?,
       next_check_at = 0 ${changed ? ", fail_count = 0, status = CASE WHEN status = 'paused' THEN 'paused' ELSE 'pending' END" : ''}
       ${d.url !== m.url ? ", domain_expires_at = NULL, ssl_expires_at = NULL, ssl_issuer = NULL, expiry_checked_at = 0, expiry_alerted = ''" : ''}
       WHERE id = ? AND user_id = ?`,
    ).bind(d.name, d.url, d.type, d.keyword, d.interval_sec, d.timeout_sec, d.method, d.follow_redirects, id, user.id).run();
    return Astro.redirect(`/dashboard/monitor?id=${id}`, 303);
  }
}
---
<Dashboard title={`Edit ${m.name}`} active="monitors" subtitle="Changes apply from the next check.">
  <MonitorForm values={values} error={error} submitLabel="Save changes" cancelHref={`/dashboard/monitor?id=${id}`} minIntervalSec={Astro.locals.plan!.limits.minIntervalSec} />
</Dashboard>
