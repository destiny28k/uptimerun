---
import { env } from 'cloudflare:workers';
import Dashboard from '../../layouts/Dashboard.astro';
import StatusDot from '../../components/dash/StatusDot.astro';
import UptimeBars from '../../components/dash/UptimeBars.astro';
import { listMonitors, listIncidents, toBars, intervalLabel, ago, fmtDate, fmtUptime } from '../../lib/data';
import { formatDuration } from '../../lib/alerts';

const user = Astro.locals.user!;
const plan = Astro.locals.plan!;
const [all, incidents] = await Promise.all([listMonitors(env.DB, user.id), listIncidents(env.DB, user.id)]);
// Problems first: down, then pending, up, paused.
const rank = { down: 0, pending: 1, up: 2, paused: 3 } as Record<string, number>;
const monitors = [...all].sort((a, b) => rank[a.status] - rank[b.status]);

const count = (s: string) => monitors.filter((m) => m.status === s).length;
const [up, down, paused] = [count('up'), count('down'), count('paused')];
const withData = monitors.filter((m) => m.uptime30 != null);
const avgUptime = withData.length ? withData.reduce((a, m) => a + (m.uptime30 ?? 0), 0) / withData.length : null;
const withMs = monitors.filter((m) => m.last_ms);
const avgMs = withMs.length ? Math.round(withMs.reduce((a, m) => a + (m.last_ms ?? 0), 0) / withMs.length) : null;
const dayAgo = Date.now() - 864e5;
const incidents24 = incidents.filter((i) => i.started_at >= dayAgo || !i.resolved_at).length;
const downNow = monitors.filter((m) => m.status === 'down');
const usedPct = Math.min(100, Math.round((monitors.length / plan.limits.monitors) * 100));
const overall = down ? 'down' : up ? 'up' : 'idle';
const since = (m: (typeof monitors)[number]) => {
  const d = formatDuration(Date.now() - (m.status_since ?? Date.now()));
  return m.status === 'up' ? `Up ${d}` : m.status === 'down' ? `Down ${d}` : m.status === 'paused' ? 'Paused' : 'First check soon';
};
const filters = [['all', 'All', monitors.length], ['down', 'Down', down], ['up', 'Up', up], ['paused', 'Paused', paused]] as const;
---
<Dashboard title="Monitors" active="monitors" subtitle="All your websites and services at a glance.">
  <a slot="actions" href="/dashboard/new" class="hidden lg:inline-flex rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-ink-950 hover:bg-brand-soft">+ New monitor</a>

  {downNow.map((m) => (
    <a href={`/dashboard/monitor?id=${m.id}`} class="mb-3 flex items-center gap-3 rounded-xl border border-red-500/30 bg-red-500/[0.07] px-4 py-3 text-sm hover:bg-red-500/10">
      <StatusDot status="down" />
      <p class="min-w-0 truncate text-red-200"><span class="font-semibold text-red-100">{m.name} is down</span> · {m.last_error ?? 'Unknown error'} · {formatDuration(Date.now() - (m.status_since ?? Date.now()))}</p>
      <span class="ml-auto shrink-0 font-medium text-red-300">View →</span>
    </a>
  ))}

  {monitors.length === 0 ? (
    <div class="rounded-2xl border border-dashed border-white/15 bg-white/[0.02] px-6 py-16 text-center">
      <span class="mx-auto grid size-12 place-items-center rounded-xl bg-brand/10 ring-1 ring-brand/20 text-brand">
        <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2.5-6 5 12 2.5-6H21"/></svg>
      </span>
      <h2 class="mt-5 text-lg font-semibold text-white">Add your first monitor</h2>
      <p class="mx-auto mt-2 max-w-sm text-sm text-slate-400">Paste a website address and we’ll start checking it right away. It takes 30 seconds.</p>
      <a href="/dashboard/new" class="mt-6 inline-flex rounded-lg bg-brand px-5 py-2.5 text-sm font-semibold text-ink-950 hover:bg-brand-soft">+ New monitor</a>
    </div>
  ) : (
    <div class="mt-3 grid gap-6 xl:grid-cols-[minmax(0,1fr)_18rem]">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <div class="flex items-center gap-1 rounded-lg border border-white/10 bg-white/[0.02] p-1 text-sm" role="group" aria-label="Filter by status">
            {filters.map(([id, label, n]) => (
              <button type="button" data-filter={id} class:list={['filter-btn rounded-md px-3 py-1.5 transition-colors', id === 'all' ? 'bg-white/10 text-white' : 'text-slate-400 hover:text-white']}>
                {label} <span class="ml-0.5 text-xs tabular-nums text-slate-500">{n}</span>
              </button>
            ))}
          </div>
          <input id="monitor-search" type="search" placeholder="Search by name or URL" autocomplete="off"
            class="w-full sm:ml-auto sm:w-64 rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2 text-sm text-white placeholder:text-slate-500 outline-none focus:border-brand/50" />
        </div>

        <ul class="mt-4 space-y-2.5">
          {monitors.map((m) => (
            <li data-search={`${m.name} ${m.url}`.toLowerCase()} data-status={m.status}>
              <a href={`/dashboard/monitor?id=${m.id}`} class:list={['group grid grid-cols-[auto_minmax(0,1fr)_auto] md:grid-cols-[auto_minmax(0,1fr)_auto_minmax(0,14rem)_4.5rem] items-center gap-x-4 gap-y-3 rounded-xl border bg-ink-900/50 px-4 py-3.5 transition-colors hover:bg-white/[0.04]', m.status === 'down' ? 'border-red-500/30' : 'border-white/10 hover:border-white/20']}>
                <span class:list={['grid size-9 place-items-center rounded-full', m.status === 'down' ? 'bg-red-500/15' : m.status === 'up' ? 'bg-brand/15' : 'bg-white/5']}><StatusDot status={m.status} /></span>
                <div class="min-w-0">
                  <p class="truncate text-sm font-medium text-white group-hover:text-brand-soft">{m.name}</p>
                  <p class="mt-1 flex items-center gap-2 truncate text-xs text-slate-500">
                    <span class="rounded border border-white/10 px-1.5 py-px text-[10px] font-medium uppercase tracking-wide text-slate-400">{m.type === 'keyword' ? 'Keyword' : 'HTTP'}</span>
                    <span class:list={[m.status === 'down' && 'text-red-300']}>{since(m)}</span>
                  </p>
                </div>
                <span class="hidden md:flex items-center gap-1.5 text-xs text-slate-500" title="Check interval">
                  <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7L21 8M21 3v5h-5"/></svg>{intervalLabel(m.interval_sec)}
                </span>
                <div class="col-span-3 md:col-span-1 order-last md:order-none"><UptimeBars history={toBars(m.history)} /></div>
                <div class="text-right">
                  <p class:list={['text-sm font-semibold tabular-nums', m.status === 'down' ? 'text-red-400' : 'text-slate-100']}>{fmtUptime(m.uptime30)}</p>
                  <p class="text-[11px] tabular-nums text-slate-500">{m.last_ms ? `${m.last_ms} ms` : m.status === 'pending' ? '—' : ago(m.last_checked_at)}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <p id="no-match" class="hidden mt-4 rounded-xl border border-white/10 px-5 py-6 text-sm text-slate-400">No monitors match.</p>
      </div>

      <aside class="grid gap-4 sm:grid-cols-2 xl:grid-cols-1 xl:content-start">
        <div class="rounded-xl border border-white/10 bg-ink-900/50 p-5">
          <p class="text-sm font-semibold text-white">Current status<span class="text-brand">.</span></p>
          <div class="mt-5 flex justify-center">
            <span class:list={['relative grid size-16 place-items-center rounded-full', overall === 'down' ? 'bg-red-500/15 text-red-400' : overall === 'up' ? 'bg-brand/15 text-brand' : 'bg-white/5 text-slate-400']}>
              {overall !== 'idle' && <span class:list={['absolute inset-0 rounded-full animate-ping opacity-20', overall === 'down' ? 'bg-red-500' : 'bg-brand']}></span>}
              <svg viewBox="0 0 24 24" class="size-7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">{overall === 'down' ? <path d="M12 7v6m0 4h.01" /> : <path d="m6 15 6-6 6 6" />}</svg>
            </span>
          </div>
          <p class:list={['mt-3 text-center text-xs font-medium', overall === 'down' ? 'text-red-300' : 'text-slate-400']}>
            {overall === 'down' ? `${down} monitor${down > 1 ? 's' : ''} down` : overall === 'up' ? 'All systems operational' : 'Waiting for first checks'}
          </p>
          <div class="mt-5 grid grid-cols-3 text-center">
            <div><p class="text-xl font-semibold tabular-nums text-red-400">{down}</p><p class="text-xs text-slate-500">Down</p></div>
            <div><p class="text-xl font-semibold tabular-nums text-brand">{up}</p><p class="text-xs text-slate-500">Up</p></div>
            <div><p class="text-xl font-semibold tabular-nums text-slate-300">{paused}</p><p class="text-xs text-slate-500">Paused</p></div>
          </div>
          <div class="mt-5 border-t border-white/5 pt-4">
            <div class="flex justify-between text-xs"><span class="text-slate-400">Using {monitors.length} of {plan.limits.monitors} monitors</span><span class="tabular-nums text-slate-500">{usedPct}%</span></div>
            <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-white/5"><div class:list={['h-full rounded-full', usedPct >= 90 ? 'bg-amber-400' : 'bg-brand']} style={`width:${Math.max(usedPct, 2)}%`}></div></div>
            {plan.id !== 'business' && <a href="/pricing" class="mt-3 inline-flex text-xs font-semibold text-brand hover:text-brand-soft">Get more monitors →</a>}
          </div>
        </div>

        <div class="rounded-xl border border-white/10 bg-ink-900/50 p-5">
          <p class="text-sm font-semibold text-white">Overview<span class="text-brand">.</span></p>
          <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-5">
            <div><dt class="text-xs text-slate-500">Uptime (30d)</dt><dd class="mt-1 text-lg font-semibold tabular-nums text-white">{fmtUptime(avgUptime)}</dd></div>
            <div><dt class="text-xs text-slate-500">Incidents (24h)</dt><dd class:list={['mt-1 text-lg font-semibold tabular-nums', incidents24 ? 'text-red-400' : 'text-white']}>{incidents24}</dd></div>
            <div><dt class="text-xs text-slate-500">Avg. response</dt><dd class="mt-1 text-lg font-semibold tabular-nums text-white">{avgMs ? `${avgMs} ms` : '—'}</dd></div>
            <div><dt class="text-xs text-slate-500">Plan</dt><dd class="mt-1 text-lg font-semibold text-white">{plan.limits.name}</dd></div>
          </dl>
        </div>
      </aside>
    </div>
  )}

  <h2 id="incidents" class="mt-12 text-lg font-semibold text-white">Recent incidents</h2>
  {incidents.length === 0 ? (
    <p class="mt-4 rounded-xl border border-white/10 bg-ink-900/50 px-5 py-6 text-sm text-slate-400">No incidents yet. Nice and quiet. 🌿</p>
  ) : (
    <div class="mt-4 overflow-x-auto rounded-xl border border-white/10">
      <table class="w-full min-w-[640px] text-sm">
        <thead class="border-b border-white/10 bg-white/[0.02] text-xs text-slate-500">
          <tr><th class="px-5 py-3 text-left font-medium">Status</th><th class="px-5 py-3 text-left font-medium">Monitor</th><th class="px-5 py-3 text-left font-medium">Root cause</th><th class="px-5 py-3 text-left font-medium">Started</th><th class="px-5 py-3 text-left font-medium">Duration</th></tr>
        </thead>
        <tbody class="divide-y divide-white/5">
          {incidents.map((i) => (
            <tr>
              <td class="px-5 py-3.5">
                <span class:list={['rounded-full px-2 py-0.5 text-xs font-medium', i.resolved_at ? 'bg-brand/10 text-brand' : 'bg-red-500/15 text-red-300']}>{i.resolved_at ? 'Resolved' : 'Ongoing'}</span>
              </td>
              <td class="px-5 py-3.5 text-white">{i.monitor_name}</td>
              <td class="px-5 py-3.5 text-slate-400">{i.cause}</td>
              <td class="px-5 py-3.5 text-slate-400">{fmtDate(i.started_at)}</td>
              <td class="px-5 py-3.5 text-slate-400">{formatDuration((i.resolved_at ?? Date.now()) - i.started_at)}{i.resolved_at ? '' : ' so far'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</Dashboard>

<script>
  // Filter the monitor list by status and search text.
  const search = document.getElementById('monitor-search') as HTMLInputElement | null;
  let status = 'all';
  const apply = () => {
    const q = (search?.value ?? '').trim().toLowerCase();
    let shown = 0;
    document.querySelectorAll<HTMLElement>('li[data-search]').forEach((li) => {
      const match = (!q || li.dataset.search!.includes(q)) && (status === 'all' || li.dataset.status === status);
      li.hidden = !match;
      if (match) shown++;
    });
    document.getElementById('no-match')?.classList.toggle('hidden', shown > 0);
  };
  search?.addEventListener('input', apply);
  document.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach((btn) => btn.addEventListener('click', () => {
    status = btn.dataset.filter!;
    document.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach((b) => {
      const on = b === btn;
      b.classList.toggle('bg-white/10', on);
      b.classList.toggle('text-white', on);
      b.classList.toggle('text-slate-400', !on);
    });
    apply();
  }));
</script>
