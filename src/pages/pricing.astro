---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Pricing from '../components/Pricing.astro';
import Footer from '../components/Footer.astro';
import { PLANS, FEATURES, YEARLY_SAVING } from '../data/plans';
import { SITE } from '../site';

const faqs = [
  ['Can I really use the free plan for my business?', 'Yes. Commercial use is allowed on every plan, including Free. No credit card needed.'],
  ['What happens to my monitors if I downgrade?', 'Your monitors and history stay. If you have more than the Free plan allows, the extra monitors are paused until you upgrade again or remove some.'],
  ['Can I switch between monthly and yearly?', `Yes, any time from Settings & billing. Yearly billing saves you ${YEARLY_SAVING}%.`],
  ['Which payment methods do you accept?', 'All major credit and debit cards. Prices are in USD, and any sales tax or VAT is calculated at checkout.'],
  ['Do you offer refunds?', 'Yes. If you’re not happy, email us within 14 days of your first payment for a full refund. See our refund policy for details.'],
  ['How does UptimeRun pricing compare to UptimeRobot, Better Stack and Pingdom?', 'For website monitoring, UptimeRun is usually the cheapest paid option: 50 monitors with 1-minute checks for $8/month and 200 monitors with 30-second checks for $16/month, billed yearly. Our side-by-side comparisons, linked below, also show where those tools offer more.'],
];

const guarantees = [
  { title: '14-day money back', text: 'Not happy? Full refund on your first payment.', icon: 'M3 12a9 9 0 1 0 3-6.7L3 8M3 3v5h5' },
  { title: 'Cancel any time', text: 'No contracts. Cancel from your dashboard.', icon: 'M18 6 6 18M6 6l12 12' },
  { title: 'Secure checkout', text: 'We never see or store your card details.', icon: 'M5 11h14v10H5zM8 11V7a4 4 0 0 1 8 0v4' },
  { title: 'Free plan, for real', text: '10 monitors forever. Commercial use allowed.', icon: 'M20 12v10H4V12M2 7h20v5H2zM12 22V7' },
];
---
<Base
  title="Pricing: Free Uptime Monitoring, Pro from $8/mo | UptimeRun"
  description="Simple uptime monitoring pricing. Free forever for 10 monitors. Pro from $8/month with 1-minute checks, SSL & domain alerts and status pages on your domain."
  breadcrumb={[{ name: 'Pricing', path: '/pricing' }]}
  jsonLd={[{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  }]}
>
  <Navbar />
  <main>
    <section class="relative overflow-hidden">
      <div class="grid-bg absolute inset-0 pointer-events-none"></div>
      <div class="glow absolute inset-0 pointer-events-none"></div>
      <div class="relative mx-auto max-w-3xl px-4 sm:px-6 pt-16 sm:pt-24 text-center">
        <p class="eyebrow">Pricing</p>
        <h1 class="mt-5 text-[2.6rem] leading-[1.05] sm:text-6xl font-semibold tracking-tight text-white text-balance"><span class="text-sheen">Fair pricing for</span> <span class="accent text-brand-soft pr-1">every website.</span></h1>
        <p class="mx-auto mt-6 max-w-xl text-base sm:text-lg leading-relaxed text-slate-400">Start free with 10 monitors. Upgrade for faster checks, more monitors and expiry alerts. All alert channels are included on every plan.</p>
      </div>
    </section>

    <div class="[&>section]:border-t-0 [&>section]:pt-0">
      <Pricing heading={false} compareLink={false} />
    </div>

    <!-- Guarantees -->
    <section class="px-4 sm:px-6 pb-8">
      <div class="mx-auto grid max-w-6xl gap-px overflow-hidden rounded-2xl bg-white/[0.06] sm:grid-cols-2 lg:grid-cols-4">
        {guarantees.map((g) => (
          <div class="flex items-start gap-3 bg-ink-950 px-5 py-5">
            <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-brand/10 text-brand-soft ring-1 ring-brand/20">
              <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d={g.icon} /></svg>
            </span>
            <div>
              <p class="text-sm font-semibold text-white">{g.title}</p>
              <p class="mt-0.5 text-[13px] leading-snug text-slate-500">{g.text}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Feature comparison -->
    <section id="compare" class="border-t border-white/5 py-24">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <div class="reveal mx-auto max-w-2xl text-center">
          <p class="eyebrow">Compare plans</p>
          <h2 class="mt-4 text-3xl sm:text-5xl font-semibold tracking-tight text-white text-balance"><span class="text-sheen">Every feature,</span> <span class="accent text-brand-soft">side by side.</span></h2>
          <p class="mt-4 text-slate-400">All alert channels are included on every plan. Pick the speed and scale you need.</p>
        </div>

        <div class="card mt-12 overflow-x-auto">
          <table class="w-full table-fixed text-[13px] sm:table-auto sm:min-w-[640px] sm:text-sm">
            <thead class="bg-white/[0.02]">
              <tr class="border-b border-white/10">
                <th class="w-[34%] px-3 py-4 text-left font-medium text-slate-400 sm:w-2/5 sm:px-5">Features</th>
                {PLANS.map((p) => (
                  <th class:list={['px-1.5 py-4 text-center sm:px-4 sm:py-5', p.featured && 'bg-brand/[0.06]']}>
                    <span class:list={['block text-sm font-semibold sm:text-base', p.featured ? 'text-brand-soft' : 'text-white']}>{p.name}</span>
                    <span class="block text-[11px] font-normal text-slate-500 sm:text-xs">{p.monthly ? `from $${(p.yearly / 12).toFixed(0)}/mo` : 'Free forever'}</span>
                  </th>
                ))}
              </tr>
            </thead>
            {FEATURES.map((g) => (
              <tbody class="divide-y divide-white/5">
                <tr class="bg-white/[0.02]"><th colspan="4" class="px-3 py-3 text-left sm:px-5 text-xs font-semibold uppercase tracking-wider text-slate-400">{g.title}</th></tr>
                {g.rows.map((r) => (
                  <tr class="hover:bg-white/[0.015]">
                    <td class="px-3 py-3 sm:px-5 sm:py-3.5">
                      <span class="text-slate-200">{r.label}</span>
                      {r.hint && <span class="hidden text-xs text-slate-500 sm:block">{r.hint}</span>}
                    </td>
                    {r.values.map((v, i) => (
                      <td class:list={['px-1.5 py-3 text-center sm:px-4 sm:py-3.5', PLANS[i].featured && 'bg-brand/[0.04]']}>
                        {v === true ? (
                          <svg viewBox="0 0 24 24" class="mx-auto size-5 text-brand" aria-label="Included" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        ) : v === false ? (
                          <span class="text-slate-600" aria-label="Not included">—</span>
                        ) : (
                          <span class:list={[v === 'Soon' ? 'rounded-full bg-white/5 px-2 py-0.5 text-xs text-slate-400' : 'font-medium text-slate-200']}>{v}</span>
                        )}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            ))}
            <tfoot>
              <tr class="border-t border-white/10">
                <td class="px-3 py-4 sm:px-5 sm:py-5"></td>
                {PLANS.map((p) => (
                  <td class:list={['px-1.5 py-4 text-center sm:px-4 sm:py-5', p.featured && 'bg-brand/[0.04]']}>
                    <a href="/signup" class:list={[
                      'inline-flex whitespace-nowrap rounded-lg px-2 py-2 text-[11px] font-semibold sm:px-4 sm:text-xs',
                      p.featured ? 'btn-primary text-ink-950' : 'btn-ghost text-white',
                    ]}>{p.monthly ? <><span class="hidden sm:inline">Get&nbsp;</span>{p.name}</> : <>Start<span class="hidden sm:inline">&nbsp;free</span></>}</a>
                  </td>
                ))}
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </section>

    <section class="border-t border-white/5 py-24">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <h2 class="text-center text-3xl sm:text-5xl font-semibold tracking-tight text-white"><span class="text-sheen">Billing</span> <span class="accent text-brand-soft">questions.</span></h2>
        <div class="card mt-12 divide-y divide-white/5">
          {faqs.map(([q, a], i) => (
            <details class="reveal group px-6 py-5" style={`--d:${i * 70}ms`}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-white">
                {q}<span class="text-xl leading-none text-slate-500 transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-slate-400">{a}</p>
            </details>
          ))}
        </div>
        <p class="mt-8 text-center text-sm text-slate-400">Comparing tools? See UptimeRun vs <a href="/compare/uptimerobot-alternative" class="text-brand hover:text-brand-soft">UptimeRobot</a>, <a href="/compare/better-stack-alternative" class="text-brand hover:text-brand-soft">Better Stack</a> and <a href="/compare/pingdom-alternative" class="text-brand hover:text-brand-soft">Pingdom</a>.</p>
      </div>
    </section>
  </main>
  <Footer />
</Base>
