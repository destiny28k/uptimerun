{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uptimerun",
  // Custom entry: Astro's fetch handler + the every-minute checker (scheduled).
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Runs the uptime checker every minute.
  "triggers": { "crons": ["* * * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uptimerun",
      "database_id": "e1e37162-8eff-4500-9ecc-8df597acb825",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "APP_URL": "http://localhost:4330",
    "EMAIL_FROM": "Upbeat Alerts <alerts@example.com>"
  }
  // Secrets (set with `wrangler secret put`, or in .dev.vars locally):
  //   BETTER_AUTH_SECRET, RESEND_API_KEY, TELEGRAM_BOT_TOKEN
}
