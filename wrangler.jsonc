{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uptimerun",
  // Custom entry: Astro's fetch handler + the every-minute checker (scheduled).
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Serve only on the real domain (no duplicate *.workers.dev copy for Google to index).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "uptimerun.com", "custom_domain": true },
    { "pattern": "www.uptimerun.com", "custom_domain": true }
  ],

  // Runs the uptime checker every minute.
  "triggers": { "crons": ["* * * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uptimerun",
      "database_id": "e1e37162-8eff-4500-9ecc-8df597acb825",
      "migrations_dir": "migrations"
    }
  ],

  // Production values. Local dev overrides APP_URL in .dev.vars.
  "vars": {
    "APP_URL": "https://uptimerun.com",
    "EMAIL_FROM": "UptimeRun <alerts@uptimerun.com>",
    "DODO_MODE": "live",
    "DODO_PRODUCTS": "{\"pro_monthly\":\"pdt_0Nsb4xpB8eaTNyQLCqLYr\",\"pro_yearly\":\"pdt_0Nsb4xushJhRPiqih8q8V\",\"business_monthly\":\"pdt_0Nsb4xzS0TylSWfRPW2vr\",\"business_yearly\":\"pdt_0Nsb4y3iPk7vfL53J3YJy\"}"
  }
  // Secrets (set with `wrangler secret put`, or in .dev.vars locally):
  //   BETTER_AUTH_SECRET, RESEND_API_KEY, TELEGRAM_BOT_TOKEN, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
}
